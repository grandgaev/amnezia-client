From de16177877fc06150ca2420978477264b848676d Mon Sep 17 00:00:00 2001
From: grandgaev <rockbrock150@gmail.com>
Date: Thu, 24 Sep 2026 18:14:41 +0000
Subject: [PATCH] feat: socket protector for the routing profiles router

The routing profiles router of amneziawg-go opens sockets for "direct"
traffic that must bypass the tunnel. On Android every such socket has to
be passed to VpnService.protect() before connect/bind.

jni.c: GoBackend.awgSetSocketProtector(protector) stores a global
reference to an object with a `boolean protect(int fd)` method (null
removes it). awgProtectSocket(fd), called by Go, invokes it from any
thread: threads unknown to the JVM are attached as daemons once and
detached by a pthread key destructor when they exit; Java exceptions are
cleared and reported as a failure. A rwlock guards the reference against
concurrent replacement.

api-android.go: installs router.SetSocketProtector with awgProtectSocket
while a Java protector is set and removes it when it is cleared.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 tunnel/tools/libwg-go/api-android.go |  22 +++++
 tunnel/tools/libwg-go/jni.c          | 122 +++++++++++++++++++++++++++
 2 files changed, 144 insertions(+)

diff --git a/tunnel/tools/libwg-go/api-android.go b/tunnel/tools/libwg-go/api-android.go
index 3af343d..1497b3b 100644
--- a/tunnel/tools/libwg-go/api-android.go
+++ b/tunnel/tools/libwg-go/api-android.go
@@ -7,6 +7,7 @@ package main
 
 // #cgo LDFLAGS: -llog
 // #include <android/log.h>
+// extern int awgProtectSocket(int fd);
 import "C"
 
 import (
@@ -23,6 +24,7 @@ import (
 	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
 	"github.com/amnezia-vpn/amneziawg-go/v3/device"
 	"github.com/amnezia-vpn/amneziawg-go/v3/ipc"
+	"github.com/amnezia-vpn/amneziawg-go/v3/router"
 	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
 	"golang.org/x/sys/unix"
 )
@@ -206,6 +208,26 @@ func awgGetConfig(tunnelHandle int32) *C.char {
 	return C.CString(settings)
 }
 
+// protectSocket hands a socket opened by the routing profiles router for
+// "direct" traffic to the Java socket protector (VpnService.protect), see
+// awgProtectSocket in jni.c. It may be called from any goroutine.
+func protectSocket(fd int) bool {
+	return C.awgProtectSocket(C.int(fd)) != 0
+}
+
+// awgSetSocketProtectorEnabled is called by
+// Java_org_amnezia_awg_GoBackend_awgSetSocketProtector after the Java
+// protector object has been installed (enabled != 0) or removed.
+//
+//export awgSetSocketProtectorEnabled
+func awgSetSocketProtectorEnabled(enabled int32) {
+	if enabled != 0 {
+		router.SetSocketProtector(protectSocket)
+	} else {
+		router.SetSocketProtector(nil)
+	}
+}
+
 //export awgVersion
 func awgVersion() *C.char {
 	info, ok := debug.ReadBuildInfo()
diff --git a/tunnel/tools/libwg-go/jni.c b/tunnel/tools/libwg-go/jni.c
index 237043e..3875fe5 100644
--- a/tunnel/tools/libwg-go/jni.c
+++ b/tunnel/tools/libwg-go/jni.c
@@ -4,8 +4,10 @@
  */
 
 #include <jni.h>
+#include <pthread.h>
 #include <stdlib.h>
 #include <string.h>
+#include <android/log.h>
 
 struct go_string { const char *str; long n; };
 extern int awgTurnOn(struct go_string ifname, int tun_fd, struct go_string settings);
@@ -14,6 +16,89 @@ extern int awgGetSocketV4(int handle);
 extern int awgGetSocketV6(int handle);
 extern char *awgGetConfig(int handle);
 extern char *awgVersion();
+extern void awgSetSocketProtectorEnabled(int enabled);
+
+/*
+ * Socket protector used by the routing profiles router of amneziawg-go: every
+ * socket it opens for "direct" traffic is handed to an object with a
+ * `boolean protect(int fd)` method (VpnService.protect on the Kotlin side)
+ * before connect/bind, so that it bypasses the tunnel.
+ *
+ * awgProtectSocket() is called from arbitrary Go threads. Threads that are not
+ * yet known to the JVM are attached once and detached by a pthread key
+ * destructor when they exit (as recommended by the Android JNI tips).
+ */
+static JavaVM *protector_vm;
+static jobject protector_obj;
+static jmethodID protector_method;
+static pthread_rwlock_t protector_lock = PTHREAD_RWLOCK_INITIALIZER;
+static pthread_mutex_t protector_set_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_key_t protector_detach_key;
+static pthread_once_t protector_detach_key_once = PTHREAD_ONCE_INIT;
+static int protector_detach_key_ok;
+
+static void protector_detach_thread(void *vm)
+{
+	(*(JavaVM *)vm)->DetachCurrentThread((JavaVM *)vm);
+}
+
+static void protector_make_detach_key(void)
+{
+	protector_detach_key_ok = pthread_key_create(&protector_detach_key, protector_detach_thread) == 0;
+}
+
+static JNIEnv *protector_get_env(JavaVM *vm)
+{
+	JNIEnv *env = NULL;
+	JavaVMAttachArgs args = { .version = JNI_VERSION_1_6, .name = "AmneziaWG/protect", .group = NULL };
+	jint ret = (*vm)->GetEnv(vm, (void **)&env, JNI_VERSION_1_6);
+
+	if (ret == JNI_OK)
+		return env;
+	if (ret != JNI_EDETACHED)
+		return NULL;
+	pthread_once(&protector_detach_key_once, protector_make_detach_key);
+	if (!protector_detach_key_ok)
+		return NULL;
+	/*
+	 * Attach as a daemon so that the threads of the Go runtime never delay
+	 * VM shutdown. void * converts to both the NDK (JNIEnv **) and the JDK
+	 * (void **) prototype.
+	 */
+	if ((*vm)->AttachCurrentThreadAsDaemon(vm, (void *)&env, &args) != JNI_OK)
+		return NULL;
+	if (pthread_setspecific(protector_detach_key, vm) != 0) {
+		(*vm)->DetachCurrentThread(vm);
+		return NULL;
+	}
+	return env;
+}
+
+int awgProtectSocket(int fd)
+{
+	int ret = 0;
+	JNIEnv *env;
+
+	pthread_rwlock_rdlock(&protector_lock);
+	if (!protector_obj) {
+		__android_log_print(ANDROID_LOG_ERROR, "AmneziaWG/Protect", "No socket protector set, socket %d is not protected", fd);
+		goto out;
+	}
+	env = protector_get_env(protector_vm);
+	if (!env) {
+		__android_log_print(ANDROID_LOG_ERROR, "AmneziaWG/Protect", "Unable to attach thread to the JVM, socket %d is not protected", fd);
+		goto out;
+	}
+	ret = (*env)->CallBooleanMethod(env, protector_obj, protector_method, (jint)fd) == JNI_TRUE;
+	if ((*env)->ExceptionCheck(env)) {
+		(*env)->ExceptionDescribe(env);
+		(*env)->ExceptionClear(env);
+		ret = 0;
+	}
+out:
+	pthread_rwlock_unlock(&protector_lock);
+	return ret;
+}
 
 JNIEXPORT jint JNICALL Java_org_amnezia_awg_GoBackend_awgTurnOn(JNIEnv *env, jclass c, jstring ifname, jint tun_fd, jstring settings)
 {
@@ -69,3 +154,40 @@ JNIEXPORT jstring JNICALL Java_org_amnezia_awg_GoBackend_awgVersion(JNIEnv *env,
 	free(version);
 	return ret;
 }
+
+JNIEXPORT void JNICALL Java_org_amnezia_awg_GoBackend_awgSetSocketProtector(JNIEnv *env, jclass c, jobject protector)
+{
+	JavaVM *vm = NULL;
+	jobject new_obj = NULL, old_obj;
+	jmethodID method = NULL;
+
+	if (protector) {
+		jclass protector_class;
+
+		if ((*env)->GetJavaVM(env, &vm) != JNI_OK)
+			return;
+		protector_class = (*env)->GetObjectClass(env, protector);
+		method = (*env)->GetMethodID(env, protector_class, "protect", "(I)Z");
+		(*env)->DeleteLocalRef(env, protector_class);
+		if (!method)
+			return; /* NoSuchMethodError is pending */
+		new_obj = (*env)->NewGlobalRef(env, protector);
+		if (!new_obj)
+			return;
+	}
+
+	/* Serialises setters so that the Go side always ends up in the same state. */
+	pthread_mutex_lock(&protector_set_lock);
+	pthread_rwlock_wrlock(&protector_lock);
+	old_obj = protector_obj;
+	protector_obj = new_obj;
+	protector_method = method;
+	if (vm)
+		protector_vm = vm;
+	pthread_rwlock_unlock(&protector_lock);
+	awgSetSocketProtectorEnabled(new_obj != NULL);
+	pthread_mutex_unlock(&protector_set_lock);
+
+	if (old_obj)
+		(*env)->DeleteGlobalRef(env, old_obj);
+}
