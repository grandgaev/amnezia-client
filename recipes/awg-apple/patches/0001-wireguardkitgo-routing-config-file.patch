From 793b8f80de3c90cb91319c9d846de14a9f7d1cf6 Mon Sep 17 00:00:00 2001
From: grandgaev <rockbrock150@gmail.com>
Date: Thu, 24 Sep 2026 18:08:28 +0000
Subject: [PATCH] feat: WireGuardKitGo: routing profiles configuration file

Add wgSetRoutingConfigFile(path), which sets the configuration file of the
rule based router of amneziawg-go (routing profiles). The path is stored
globally and applied right away to the running tunnels; wgTurnOn loads it
into every new device right after the device is created, before the peers
are configured and the device is brought up, so no packet reaches the
tunnel without the routing rules. An empty path disables the router.

The WireGuardKit Swift sources build the UAPI configuration themselves, so
the routing_config_file UAPI key cannot be passed through wgTurnOn's
settings; a dedicated entry point keeps them unchanged.

Close the device (instead of only the duplicated TUN descriptor) when
wgTurnOn fails after the device has been created, so that the router and
the device goroutines are stopped. Sort the imports (gofmt).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Sources/WireGuardKitGo/api-apple.go | 65 +++++++++++++++++++++++++++--
 Sources/WireGuardKitGo/wireguard.h  |  1 +
 2 files changed, 63 insertions(+), 3 deletions(-)

diff --git a/Sources/WireGuardKitGo/api-apple.go b/Sources/WireGuardKitGo/api-apple.go
index 58cb59a..ded77d1 100644
--- a/Sources/WireGuardKitGo/api-apple.go
+++ b/Sources/WireGuardKitGo/api-apple.go
@@ -21,13 +21,14 @@ import (
 	"runtime"
 	"runtime/debug"
 	"strings"
+	"sync"
 	"time"
 	"unsafe"
 
-	"golang.org/x/sys/unix"
 	"github.com/amnezia-vpn/amneziawg-go/v3/conn"
 	"github.com/amnezia-vpn/amneziawg-go/v3/device"
 	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+	"golang.org/x/sys/unix"
 )
 
 var loggerFunc unsafe.Pointer
@@ -58,6 +59,15 @@ type tunnelHandle struct {
 
 var tunnelHandles = make(map[int32]tunnelHandle)
 
+// routingMu guards routingConfigPath and the modifications of tunnelHandles,
+// so that a routing configuration set while a tunnel is being turned on is
+// applied to it exactly once.
+var routingMu sync.Mutex
+
+// routingConfigPath is the configuration file of the rule based router
+// (routing profiles) applied to every tunnel; empty disables the router.
+var routingConfigPath string
+
 func init() {
 	signals := make(chan os.Signal)
 	signal.Notify(signals, unix.SIGUSR2)
@@ -109,10 +119,26 @@ func wgTurnOn(settings *C.char, tunFd int32) int32 {
 	logger.Verbosef("Attaching to interface")
 	dev := device.NewDevice(tun, conn.NewStdNetBind(), logger)
 
+	routingMu.Lock()
+	defer routingMu.Unlock()
+
+	// The router must be configured before the device is up, so that no
+	// packet reaches the tunnel without the routing rules being applied.
+	if routingConfigPath != "" {
+		err = dev.Router().Configure(routingConfigPath)
+		if err != nil {
+			logger.Errorf("Unable to apply routing configuration: %v", err)
+			dev.Close()
+			return -1
+		}
+	}
+
 	err = dev.IpcSet(C.GoString(settings))
 	if err != nil {
 		logger.Errorf("Unable to set IPC settings: %v", err)
-		unix.Close(dupTunFd)
+		// Closing the device closes the duplicated TUN descriptor and stops
+		// the router, which would otherwise keep running.
+		dev.Close()
 		return -1
 	}
 
@@ -135,14 +161,47 @@ func wgTurnOn(settings *C.char, tunFd int32) int32 {
 
 //export wgTurnOff
 func wgTurnOff(tunnelHandle int32) {
+	routingMu.Lock()
 	dev, ok := tunnelHandles[tunnelHandle]
+	if ok {
+		delete(tunnelHandles, tunnelHandle)
+	}
+	routingMu.Unlock()
 	if !ok {
 		return
 	}
-	delete(tunnelHandles, tunnelHandle)
 	dev.Close()
 }
 
+// wgSetRoutingConfigFile sets the configuration file of the rule based router
+// (routing profiles). The file is loaded by every tunnel turned on afterwards,
+// right after its device is created and before it is brought up, and it is
+// applied immediately to the running tunnels. An empty path disables the
+// router. Returns 0 on success, or -1 if the configuration could not be
+// applied to a running tunnel (the tunnel keeps its previous routing).
+//
+//export wgSetRoutingConfigFile
+func wgSetRoutingConfigFile(path *C.char) int32 {
+	configPath := ""
+	if path != nil {
+		configPath = C.GoString(path)
+	}
+
+	routingMu.Lock()
+	defer routingMu.Unlock()
+
+	routingConfigPath = configPath
+	ret := int32(0)
+	for _, handle := range tunnelHandles {
+		err := handle.Router().Configure(configPath)
+		if err != nil {
+			handle.Errorf("Unable to apply routing configuration: %v", err)
+			ret = -1
+		}
+	}
+	return ret
+}
+
 //export wgSetConfig
 func wgSetConfig(tunnelHandle int32, settings *C.char) int64 {
 	dev, ok := tunnelHandles[tunnelHandle]
diff --git a/Sources/WireGuardKitGo/wireguard.h b/Sources/WireGuardKitGo/wireguard.h
index 7234c3d..8327c26 100644
--- a/Sources/WireGuardKitGo/wireguard.h
+++ b/Sources/WireGuardKitGo/wireguard.h
@@ -18,6 +18,7 @@ extern int64_t wgSetConfig(int handle, const char *settings);
 extern char *wgGetConfig(int handle);
 extern void wgBumpSockets(int handle);
 extern void wgDisableSomeRoamingForBrokenMobileSemantics(int handle);
+extern int wgSetRoutingConfigFile(const char *path);
 extern const char *wgVersion();
 
 typedef void (*libxray_sockcallback)(uintptr_t fd, void* ctx);
