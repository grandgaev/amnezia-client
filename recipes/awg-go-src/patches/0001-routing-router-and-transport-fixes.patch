+func dnsQuery(t *testing.T, id uint16, name string, qtype dnsmessage.Type) []byte {
+	b := dnsmessage.NewBuilder(nil, dnsmessage.Header{ID: id, RecursionDesired: true})
+	b.StartQuestions()
+	b.Question(dnsmessage.Question{Name: dnsmessage.MustNewName(name), Type: qtype, Class: dnsmessage.ClassINET})
+	msg, err := b.Finish()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return msg
+}
+
+func dnsAnswer(t *testing.T, query []byte, addrs ...string) []byte {
+	var p dnsmessage.Parser
+	h, err := p.Start(query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	q, _ := p.Question()
+	h.Response = true
+	b := dnsmessage.NewBuilder(nil, h)
+	b.StartQuestions()
+	b.Question(q)
+	b.StartAnswers()
+	for _, a := range addrs {
+		ip := netip.MustParseAddr(a)
+		rh := dnsmessage.ResourceHeader{Name: q.Name, Class: dnsmessage.ClassINET, TTL: 30}
+		if ip.Is4() {
+			b.AResource(rh, dnsmessage.AResource{A: ip.As4()})
+		} else {
+			b.AAAAResource(rh, dnsmessage.AAAAResource{AAAA: ip.As16()})
+		}
+	}
+	msg, err := b.Finish()
+	if err != nil {
+		t.Fatal(err)
+	}
+	return msg
+}
+
+func udpPayload(t *testing.T, pkt []byte) (packetInfo, []byte) {
+	t.Helper()
+	var info packetInfo
+	if !parsePacket(pkt, &info) || info.proto != protoUDP {
+		t.Fatalf("not a UDP packet: % x", pkt)
+	}
+	return info, pkt[info.ipHdrLen+udpHeaderLen : info.totalLen]
+}
+
+func tcpSyn(src, dst netip.AddrPort) []byte {
+	pkt := make([]byte, ipHeaderLen(src.Addr())+tcpHeaderMinLen)
+	hl := buildIPHeader(pkt, src.Addr(), dst.Addr(), protoTCP, tcpHeaderMinLen)
+	tcp := pkt[hl:]
+	binary.BigEndian.PutUint16(tcp[0:2], src.Port())
+	binary.BigEndian.PutUint16(tcp[2:4], dst.Port())
+	binary.BigEndian.PutUint32(tcp[4:8], 12345)
+	tcp[12] = 5 << 4
+	tcp[13] = tcpFlagSYN
+	binary.BigEndian.PutUint16(tcp[14:16], 65535)
+	var info packetInfo
+	parsePacket(pkt, &info)
+	fixChecksums(pkt, &info)
+	return pkt
+}
