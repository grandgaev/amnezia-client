+}
+
+func TestRouterDisable(t *testing.T) {
+	h := newHarness(t, baseConfig())
+	if err := h.r.Configure(""); err != nil {
+		t.Fatal(err)
+	}
+	q := dnsQuery(t, 0x5555, "tracker.ads.example.", dnsmessage.TypeA)
+	pkt := buildUDPPacket(0, client, vip, q)
+	h.fromOS(pkt)
+	out := h.expectToTunnel(time.Second)
+	if string(out) != string(pkt) {
+		t.Fatal("disabled router modified a packet")
