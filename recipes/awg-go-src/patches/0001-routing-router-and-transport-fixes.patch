+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/netip"
+	"os"
+	"strings"
+)
+
+// Action is the routing decision for a flow.
+type Action uint8
+
+const (
+	ActionProxy  Action = iota // send through the tunnel
+	ActionDirect               // send outside the tunnel
+	ActionBlock                // drop / reject
+)
+
+func (a Action) String() string {
+	switch a {
+	case ActionProxy:
+		return "proxy"
+	case ActionDirect:
+		return "direct"
+	case ActionBlock:
+		return "block"
+	}
+	return "unknown"
+}
+
+func parseAction(s string) (Action, error) {
+	switch strings.ToLower(strings.TrimSpace(s)) {
+	case "proxy", "vpn", "tunnel":
+		return ActionProxy, nil
+	case "direct", "bypass":
+		return ActionDirect, nil
+	case "block", "reject", "blackhole":
+		return ActionBlock, nil
+	}
+	return ActionProxy, fmt.Errorf("unknown action %q", s)
+}
+
+// RuleConfig is one ordered routing rule. A flow matches the rule when its
+// destination domain (learned from DNS) matches Domains or its destination
+// address is in IPs.
+type RuleConfig struct {
+	Action  string   `json:"action"`
+	Domains []string `json:"domains,omitempty"`
+	IPs     []string `json:"ips,omitempty"`
+}
+
+// DNSConfig controls DNS interception.
+type DNSConfig struct {
+	// Addresses the router answers on (DNS servers announced to the OS).
+	// UDP/53 queries are intercepted regardless of the destination, but TCP/53
+	// is only served for these addresses.
+	Listen []string `json:"listen,omitempty"`
+	// Upstreams used for proxied names; reached through the tunnel.
+	Remote []string `json:"remote,omitempty"`
+	// Upstreams used for direct names; reached outside the tunnel.
+	Direct []string `json:"direct,omitempty"`
+	// Optional DNS-over-HTTPS resolver for direct names, tried before Direct.
+	DirectDoH *DoHConfig `json:"directDoh,omitempty"`
+	// Static answers.
+	Hosts map[string][]string `json:"hosts,omitempty"`
+	// "nxdomain" (default) or "zero": how names matching a block rule are
+	// answered.
+	BlockAnswer string `json:"blockAnswer,omitempty"`
+	// Minimum lifetime of learned address->rule associations, in seconds.
+	MinTTL int `json:"minTtl,omitempty"`
+}
+
+// Config is the JSON document loaded from routing_config_file.
+type Config struct {
+	Version       int          `json:"version"`
+	DefaultAction string       `json:"defaultAction"`
+	Rules         []RuleConfig `json:"rules"`
+	DNS           DNSConfig    `json:"dns"`
+	// Bypass describes how sockets for direct traffic escape the tunnel:
+	// "os" (the platform guarantees it, e.g. NetworkExtension provider or
+	// Android with a socket protector), "interface" (bind to the interface
+	// given via UAPI routing_bypass_* keys).
+	Bypass string `json:"bypass,omitempty"`
+	// BlockQUIC rejects UDP/443 for proxied flows so browsers fall back to TCP.
+	BlockQUIC bool `json:"blockQuic,omitempty"`
+	// RejectProxyIPv6 is set when the tunnel carries no IPv6: proxied IPv6
+	// connections are refused at once (instead of being black-holed by the
+	// server) and names going through the tunnel get no AAAA records, so
+	// applications use IPv4 without waiting for a timeout.
+	RejectProxyIPv6 bool `json:"rejectProxyIpv6,omitempty"`
+}
+
+type compiledRule struct {
+	action  Action
+	domains *DomainSet
+	ips     *IPSet
+}
+
+type compiledConfig struct {
+	defaultAction Action
+	rules         []compiledRule
+	listen        []netip.Addr
+	remote        []netip.AddrPort
+	direct        []netip.AddrPort
+	directDoH     *dohUpstream
+	hosts         map[string][]netip.Addr
+	blockZero     bool
+	minTTL        uint32
+	bypassOS      bool
+	blockQUIC     bool
+	rejectV6Proxy bool
+	hasDirect     bool
+}
+
+// LoadConfigFile reads and compiles a router configuration.
+func LoadConfigFile(path string) (*compiledConfig, error) {
+	data, err := os.ReadFile(path)
+	if err != nil {
+		return nil, err
+	}
+	var cfg Config
+	if err := json.Unmarshal(data, &cfg); err != nil {
+		return nil, fmt.Errorf("parse %s: %w", path, err)
+	}
+	return compileConfig(&cfg)
+}
+
+func parseDNSServer(s string) (netip.AddrPort, error) {
+	s = strings.TrimSpace(s)
+	s = strings.TrimPrefix(s, "udp://")
+	if ap, err := netip.ParseAddrPort(s); err == nil {
+		return ap, nil
+	}
+	a, err := netip.ParseAddr(strings.Trim(s, "[]"))
+	if err != nil {
+		return netip.AddrPort{}, err
+	}
+	return netip.AddrPortFrom(a, 53), nil
+}
+
+func compileConfig(cfg *Config) (*compiledConfig, error) {
+	c := &compiledConfig{
+		defaultAction: ActionProxy,
+		hosts:         map[string][]netip.Addr{},
+		minTTL:        60,
+		bypassOS:      cfg.Bypass == "" || cfg.Bypass == "os",
+		blockQUIC:     cfg.BlockQUIC,
+		rejectV6Proxy: cfg.RejectProxyIPv6,
+	}
+	if cfg.DefaultAction != "" {
+		a, err := parseAction(cfg.DefaultAction)
+		if err != nil {
+			return nil, err
+		}
+		c.defaultAction = a
+	}
+	for i, r := range cfg.Rules {
+		a, err := parseAction(r.Action)
+		if err != nil {
+			return nil, fmt.Errorf("rule %d: %w", i, err)
+		}
+		ds := &DomainSet{}
+		for _, d := range r.Domains {
+			if err := ds.add(d); err != nil {
+				return nil, fmt.Errorf("rule %d: %w", i, err)
+			}
+		}
+		ds.finalize()
+		var prefixes []netip.Prefix
+		for _, ip := range r.IPs {
+			p, err := ParsePrefixOrAddr(ip)
+			if err != nil {
+				return nil, fmt.Errorf("rule %d: invalid address %q: %w", i, ip, err)
+			}
+			prefixes = append(prefixes, p)
+		}
+		cr := compiledRule{action: a}
+		if !ds.Empty() {
+			cr.domains = ds
+		}
+		if len(prefixes) > 0 {
+			cr.ips = buildIPSet(prefixes)
+		}
+		if cr.domains == nil && cr.ips == nil {
+			continue
+		}
+		if a == ActionDirect {
+			c.hasDirect = true
+		}
+		c.rules = append(c.rules, cr)
+	}
+	if c.defaultAction == ActionDirect {
+		c.hasDirect = true
+	}
+	for _, l := range cfg.DNS.Listen {
+		a, err := netip.ParseAddr(strings.TrimSpace(l))
+		if err != nil {
+			return nil, fmt.Errorf("dns listen %q: %w", l, err)
+		}
+		c.listen = append(c.listen, a)
+	}
+	for _, s := range cfg.DNS.Remote {
+		ap, err := parseDNSServer(s)
+		if err != nil {
+			return nil, fmt.Errorf("dns remote %q: %w", s, err)
+		}
+		c.remote = append(c.remote, ap)
+	}
+	for _, s := range cfg.DNS.Direct {
+		ap, err := parseDNSServer(s)
+		if err != nil {
+			return nil, fmt.Errorf("dns direct %q: %w", s, err)
+		}
+		c.direct = append(c.direct, ap)
+	}
+	doh, err := compileDoH(cfg.DNS.DirectDoH)
+	if err != nil {
+		return nil, fmt.Errorf("dns directDoh: %w", err)
+	}
+	c.directDoH = doh
+	for name, addrs := range cfg.DNS.Hosts {
+		n := NormalizeDomain(name)
+		for _, s := range addrs {
+			a, err := netip.ParseAddr(strings.TrimSpace(s))
+			if err != nil {
+				return nil, fmt.Errorf("dns host %q: %w", s, err)
+			}
+			c.hosts[n] = append(c.hosts[n], a)
+		}
+	}
+	c.blockZero = strings.EqualFold(cfg.DNS.BlockAnswer, "zero")
+	if cfg.DNS.MinTTL > 0 {
+		c.minTTL = uint32(cfg.DNS.MinTTL)
+	}
+	if len(c.remote) == 0 {
+		return nil, fmt.Errorf("at least one remote DNS server is required")
+	}
+	return c, nil
+}
+
+// matchDomain returns the index of the first rule whose domain set matches
+// name, or -1.
+func (c *compiledConfig) matchDomain(name string) int {
+	for i := range c.rules {
+		if c.rules[i].domains != nil && c.rules[i].domains.Match(name) {
+			return i
+		}
+	}
+	return -1
+}
+
+// decide returns the action for a destination address. learnedRule is the
+// index of the rule matched by the domain name the address was resolved
+// from (or -1).
+func (c *compiledConfig) decide(dst netip.Addr, learnedRule int) Action {
+	for i := range c.rules {
+		if i == learnedRule {
+			return c.rules[i].action
+		}
+		if c.rules[i].ips != nil && c.rules[i].ips.Contains(dst) {
+			return c.rules[i].action
+		}
+	}
+	return c.defaultAction
+}
+
+// domainAction returns the action and matching rule for a DNS name. When no
+// rule matches, the default action is returned with rule -1.
+func (c *compiledConfig) domainAction(name string) (Action, int) {
+	if i := c.matchDomain(name); i >= 0 {
+		return c.rules[i].action, i
+	}
+	return c.defaultAction, -1
+}
+
+func (c *compiledConfig) isListenAddr(a netip.Addr) bool {
+	for _, l := range c.listen {
+		if l == a {
+			return true
+		}
+	}
+	return false
+}
