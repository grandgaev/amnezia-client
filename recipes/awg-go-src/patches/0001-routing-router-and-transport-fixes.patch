+func TestIPSet(t *testing.T) {
+	var prefixes []netip.Prefix
+	for _, s := range []string{"10.0.0.0/8", "10.1.0.0/16", "192.168.1.1", "192.168.1.2", "0.0.0.0/32", "2001:db8::/32", "::1"} {
+		p, err := ParsePrefixOrAddr(s)
+		if err != nil {
+			t.Fatal(err)
+		}
+		prefixes = append(prefixes, p)
+	}
+	set := buildIPSet(prefixes)
+	if len(set.v4) != 3 {
+		t.Errorf("expected merged v4 ranges, got %v", set.v4)
+	}
+	cases := map[string]bool{
+		"10.0.0.0":         true,
+		"10.255.255.255":   true,
+		"11.0.0.0":         false,
+		"9.255.255.255":    false,
+		"192.168.1.1":      true,
+		"192.168.1.2":      true,
+		"192.168.1.3":      false,
+		"0.0.0.0":          true,
+		"0.0.0.1":          false,
+		"2001:db8::1":      true,
+		"2001:db9::1":      false,
+		"::1":              true,
+		"::2":              false,
+		"::ffff:10.2.3.4":  true,
+		"255.255.255.255":  false,
+		"2001:db8:ffff::1": true,
+	}
+	for s, want := range cases {
+		if got := set.Contains(netip.MustParseAddr(s)); got != want {
+			t.Errorf("Contains(%s) = %v, want %v", s, got, want)
+		}
+	}
+	all := buildIPSet([]netip.Prefix{netip.MustParsePrefix("0.0.0.0/0")})
+	if !all.Contains(netip.MustParseAddr("255.255.255.255")) || !all.Contains(netip.MustParseAddr("0.0.0.0")) {
+		t.Error("0.0.0.0/0 does not cover everything")
+	}
+}
+
+func verifyChecksums(t *testing.T, pkt []byte) {
+	t.Helper()
+	var info packetInfo
+	if !parsePacket(pkt, &info) {
+		t.Fatal("parse failed")
+	}
+	if info.version == 4 && checksumFold(checksumAdd(0, pkt[:info.ipHdrLen])) != 0 {
+		t.Error("bad IPv4 header checksum")
+	}
+	l4 := pkt[info.ipHdrLen:info.totalLen]
+	var sum uint32
+	switch info.proto {
+	case protoUDP, protoTCP, protoICMPv6:
+		sum = pseudoHeaderSum(info.src, info.dst, info.proto, len(l4))
+	}
+	if checksumFold(checksumAdd(sum, l4)) != 0 {
+		t.Errorf("bad transport checksum (proto %d)", info.proto)
+	}
+}
+
+func TestPacketBuilders(t *testing.T) {
+	for _, pair := range [][2]string{{"10.8.1.2", "1.1.1.1"}, {"fd00::2", "2001:db8::1"}} {
+		src := netip.AddrPortFrom(netip.MustParseAddr(pair[0]), 5353)
+		dst := netip.AddrPortFrom(netip.MustParseAddr(pair[1]), 53)
+		buf := buildUDPPacket(injectHeadroom, src, dst, []byte("hello world"))
+		pkt := buf[injectHeadroom:]
+		verifyChecksums(t, pkt)
+		var info packetInfo
+		parsePacket(pkt, &info)
+		if info.src != src.Addr() || info.dst != dst.Addr() || info.srcPort != 5353 || info.dstPort != 53 || info.proto != protoUDP {
+			t.Fatalf("unexpected parse result %+v", info)
+		}
+		// rewrite and re-verify
+		setAddr(pkt, &info, false, netip.MustParseAddr(map[bool]string{true: "8.8.8.8", false: "2001:4860::8888"}[src.Addr().Is4()]))
+		fixChecksums(pkt, &info)
+		verifyChecksums(t, pkt)
+
+		// TCP SYN -> RST
+		syn := make([]byte, ipHeaderLen(src.Addr())+tcpHeaderMinLen)
+		hl := buildIPHeader(syn, src.Addr(), dst.Addr(), protoTCP, tcpHeaderMinLen)
+		tcp := syn[hl:]
+		binary.BigEndian.PutUint16(tcp[0:2], 40000)
+		binary.BigEndian.PutUint16(tcp[2:4], 443)
+		binary.BigEndian.PutUint32(tcp[4:8], 1000)
+		tcp[12] = 5 << 4
+		tcp[13] = tcpFlagSYN
+		var sinfo packetInfo
+		parsePacket(syn, &sinfo)
+		fixChecksums(syn, &sinfo)
+		verifyChecksums(t, syn)
+		rst := buildTCPReset(0, syn, &sinfo)
+		verifyChecksums(t, rst)
+		var rinfo packetInfo
+		parsePacket(rst, &rinfo)
+		if rinfo.tcpFlags != tcpFlagRST|tcpFlagACK || binary.BigEndian.Uint32(rst[rinfo.ipHdrLen+8:]) != 1001 {
+			t.Errorf("unexpected RST %+v", rinfo)
+		}
+		verifyChecksums(t, buildICMPUnreachable(0, syn, &sinfo))
+		verifyChecksums(t, buildICMPEchoReply(0, dst.Addr(), src.Addr(), 1, 2, []byte("ping")))
+	}
+}
