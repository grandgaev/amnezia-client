@@ -0,0 +1,94 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package device
+
+import (
+	"net"
+	"strconv"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/ipc"
+	"github.com/amnezia-vpn/amneziawg-go/v3/router"
+	"golang.org/x/net/ipv4"
+	"golang.org/x/net/ipv6"
+)
+
+// Router returns the split tunnelling router attached to the device.
+func (device *Device) Router() *router.Router {
+	return device.router
+}
+
+// injectOutbound sends an IP packet generated by the router through the
+// tunnel, as if it had been read from the TUN device.
+func (device *Device) injectOutbound(pkt []byte) {
+	if len(pkt) == 0 || device.isClosed() || !device.isUp() {
+		return
+	}
+	var peer *Peer
+	switch pkt[0] >> 4 {
+	case 4:
+		if len(pkt) < ipv4.HeaderLen {
+			return
+		}
+		peer = device.allowedips.Lookup(pkt[IPv4offsetDst : IPv4offsetDst+net.IPv4len])
+	case 6:
+		if len(pkt) < ipv6.HeaderLen {
+			return
+		}
+		peer = device.allowedips.Lookup(pkt[IPv6offsetDst : IPv6offsetDst+net.IPv6len])
+	}
+	if peer == nil || !peer.isRunning.Load() {
+		return
+	}
+	elem := device.NewOutboundElement()
+	offset := MessageTransportHeaderSize + int(elem.padding)
+	if offset+len(pkt) > len(elem.buffer) {
+		device.PutMessageBuffer(elem.buffer)
+		device.PutOutboundElement(elem)
+		return
+	}
+	copy(elem.buffer[offset:], pkt)
+	elem.packet = elem.buffer[offset : offset+len(pkt)]
+	container := device.GetOutboundElementsContainer()
+	container.elems = append(container.elems, elem)
+	peer.StagePackets(container)
+	peer.SendStagedPackets()
+}
+
+func (device *Device) handleRouterLine(key, value string) (bool, error) {
+	switch key {
+	case "routing_config_file":
+		device.log.Verbosef("UAPI: Updating routing configuration")
+		if err := device.router.Configure(value); err != nil {
+			return true, ipcErrorf(ipc.IpcErrorInvalid, "failed to load routing configuration: %w", err)
+		}
+	case "routing_bypass_ifindex":
+		idx, err := strconv.ParseUint(value, 10, 32)
+		if err != nil {
+			return true, ipcErrorf(ipc.IpcErrorInvalid, "failed to parse routing_bypass_ifindex: %w", err)
+		}
+		device.log.Verbosef("UAPI: Updating routing bypass interface: %d", idx)
+		device.router.SetBypassInterface(uint32(idx))
+	case "routing_bypass_ifindex6":
+		idx, err := strconv.ParseUint(value, 10, 32)
+		if err != nil {
+			return true, ipcErrorf(ipc.IpcErrorInvalid, "failed to parse routing_bypass_ifindex6: %w", err)
+		}
+		device.log.Verbosef("UAPI: Updating routing bypass IPv6 interface: %d", idx)
+		device.router.SetBypassInterface6(uint32(idx))
+	case "routing_bypass_ifname":
+		device.log.Verbosef("UAPI: Updating routing bypass interface name: %s", value)
+		device.router.SetBypassInterfaceName(value)
+	case "routing_bypass_fwmark":
+		mark, err := strconv.ParseUint(value, 10, 32)
+		if err != nil {
+			return true, ipcErrorf(ipc.IpcErrorInvalid, "failed to parse routing_bypass_fwmark: %w", err)
+		}
+		device.router.SetBypassMark(uint32(mark))
+	default:
+		return false, nil
+	}
+	return true, nil
+}
