new file mode 100644
index 0000000..4262560
--- /dev/null
+++ b/router/packet.go
@@ -0,0 +1,431 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"encoding/binary"
+	"net/netip"
+)
+
+const (
+	protoICMP   = 1
+	protoTCP    = 6
+	protoUDP    = 17
+	protoICMPv6 = 58
+
+	ipv4HeaderMinLen = 20
+	ipv6HeaderLen    = 40
+	udpHeaderLen     = 8
+	tcpHeaderMinLen  = 20
+
+	tcpFlagFIN = 0x01
+	tcpFlagSYN = 0x02
+	tcpFlagRST = 0x04
+	tcpFlagACK = 0x10
+)
+
+// packetInfo describes the parts of an IP packet the router cares about.
+type packetInfo struct {
+	version   int
+	proto     uint8
+	src, dst  netip.Addr
+	srcPort   uint16
+	dstPort   uint16
+	ipHdrLen  int // offset of the transport header
+	l4Len     int // length of transport header + payload
+	tcpFlags  uint8
+	fragment  bool // non-first fragment or fragmented datagram
+	totalLen  int
+	icmpType  uint8
+	icmpCode  uint8
+	transport bool // transport header was parsed
+}
+
+// parsePacket extracts addressing information from a raw IP packet.
+// It returns false when the packet is malformed.
+func parsePacket(pkt []byte, info *packetInfo) bool {
+	*info = packetInfo{}
+	if len(pkt) < 1 {
+		return false
+	}
+	switch pkt[0] >> 4 {
+	case 4:
+		if len(pkt) < ipv4HeaderMinLen {
+			return false
+		}
+		ihl := int(pkt[0]&0x0f) * 4
+		total := int(binary.BigEndian.Uint16(pkt[2:4]))
+		if ihl < ipv4HeaderMinLen || total < ihl || total > len(pkt) {
+			return false
+		}
+		info.version = 4
+		info.proto = pkt[9]
+		info.src = netip.AddrFrom4([4]byte(pkt[12:16]))
+		info.dst = netip.AddrFrom4([4]byte(pkt[16:20]))
+		info.ipHdrLen = ihl
+		info.totalLen = total
+		flagsFrag := binary.BigEndian.Uint16(pkt[6:8])
+		moreFragments := flagsFrag&0x2000 != 0
+		fragOffset := flagsFrag & 0x1fff
+		if moreFragments || fragOffset != 0 {
+			info.fragment = true
+			if fragOffset != 0 {
+				// No transport header in non-first fragments.
+				return true
+			}
+		}
+		info.l4Len = total - ihl
+	case 6:
+		if len(pkt) < ipv6HeaderLen {
+			return false
+		}
+		payloadLen := int(binary.BigEndian.Uint16(pkt[4:6]))
+		if ipv6HeaderLen+payloadLen > len(pkt) {
+			return false
+		}
+		info.version = 6
+		info.src = netip.AddrFrom16([16]byte(pkt[8:24]))
+		info.dst = netip.AddrFrom16([16]byte(pkt[24:40]))
+		info.totalLen = ipv6HeaderLen + payloadLen
+		next := pkt[6]
+		off := ipv6HeaderLen
+		// Walk a limited set of extension headers.
+		for i := 0; i < 8; i++ {
+			switch next {
+			case 0, 43, 60: // hop-by-hop, routing, destination options
+				if off+8 > info.totalLen {
+					return false
+				}
+				next = pkt[off]
+				off += (int(pkt[off+1]) + 1) * 8
+				continue
+			case 44: // fragment
+				if off+8 > info.totalLen {
+					return false
+				}
+				info.fragment = true
+				fragOffset := binary.BigEndian.Uint16(pkt[off+2:off+4]) >> 3
+				next = pkt[off]
+				off += 8
+				if fragOffset != 0 {
+					info.proto = next
+					info.ipHdrLen = off
+					return true
+				}
+				continue
+			}
+			break
+		}
+		if off > info.totalLen {
+			return false
+		}
+		info.proto = next
+		info.ipHdrLen = off
+		info.l4Len = info.totalLen - off
+	default:
+		return false
+	}
+
+	l4 := pkt[info.ipHdrLen:info.totalLen]
+	switch info.proto {
+	case protoTCP:
+		if len(l4) < tcpHeaderMinLen {
+			return info.fragment
+		}
+		info.srcPort = binary.BigEndian.Uint16(l4[0:2])
+		info.dstPort = binary.BigEndian.Uint16(l4[2:4])
+		info.tcpFlags = l4[13]
+		info.transport = true
+	case protoUDP:
+		if len(l4) < udpHeaderLen {
+			return info.fragment
+		}
+		info.srcPort = binary.BigEndian.Uint16(l4[0:2])
+		info.dstPort = binary.BigEndian.Uint16(l4[2:4])
+		info.transport = true
+	case protoICMP, protoICMPv6:
+		if len(l4) >= 4 {
+			info.icmpType = l4[0]
+			info.icmpCode = l4[1]
+			info.transport = true
+		}
+	}
+	return true
+}
+
+// checksumAdd folds the one's complement sum of b into sum.
+func checksumAdd(sum uint32, b []byte) uint32 {
+	n := len(b)
+	i := 0
+	for ; i+1 < n; i += 2 {
+		sum += uint32(b[i])<<8 | uint32(b[i+1])
+	}
+	if i < n {
+		sum += uint32(b[i]) << 8
+	}
+	return sum
+}
+
+func checksumFold(sum uint32) uint16 {
+	for sum>>16 != 0 {
+		sum = (sum & 0xffff) + (sum >> 16)
+	}
+	return ^uint16(sum)
+}
+
+func pseudoHeaderSum(src, dst netip.Addr, proto uint8, length int) uint32 {
+	var sum uint32
+	if src.Is4() {
+		s := src.As4()
+		d := dst.As4()
+		sum = checksumAdd(sum, s[:])
+		sum = checksumAdd(sum, d[:])
+	} else {
+		s := src.As16()
+		d := dst.As16()
+		sum = checksumAdd(sum, s[:])
+		sum = checksumAdd(sum, d[:])
+	}
+	sum += uint32(proto)
+	sum += uint32(length)
+	return sum
+}
+
+// fixChecksums recomputes the IPv4 header checksum and the TCP/UDP/ICMP
+// checksum of a packet described by info (addresses/ports must already be
+// updated in info and in the packet).
+func fixChecksums(pkt []byte, info *packetInfo) {
+	if info.version == 4 {
+		pkt[10], pkt[11] = 0, 0
+		cs := checksumFold(checksumAdd(0, pkt[:info.ipHdrLen]))
+		binary.BigEndian.PutUint16(pkt[10:12], cs)
+	}
+	if info.fragment {
+		return
+	}
+	l4 := pkt[info.ipHdrLen:info.totalLen]
+	switch info.proto {
+	case protoUDP:
+		if len(l4) < udpHeaderLen {
+			return
+		}
+		l4[6], l4[7] = 0, 0
+		sum := pseudoHeaderSum(info.src, info.dst, protoUDP, len(l4))
+		cs := checksumFold(checksumAdd(sum, l4))
+		if cs == 0 {
+			cs = 0xffff
+		}
+		binary.BigEndian.PutUint16(l4[6:8], cs)
+	case protoTCP:
+		if len(l4) < tcpHeaderMinLen {
+			return
+		}
+		l4[16], l4[17] = 0, 0
+		sum := pseudoHeaderSum(info.src, info.dst, protoTCP, len(l4))
+		binary.BigEndian.PutUint16(l4[16:18], checksumFold(checksumAdd(sum, l4)))
+	case protoICMP:
+		if len(l4) < 4 {
+			return
+		}
+		l4[2], l4[3] = 0, 0
+		binary.BigEndian.PutUint16(l4[2:4], checksumFold(checksumAdd(0, l4)))
+	case protoICMPv6:
+		if len(l4) < 4 {
+			return
+		}
+		l4[2], l4[3] = 0, 0
+		sum := pseudoHeaderSum(info.src, info.dst, protoICMPv6, len(l4))
+		binary.BigEndian.PutUint16(l4[2:4], checksumFold(checksumAdd(sum, l4)))
+	}
+}
+
+// setAddr rewrites the source (src=true) or destination address of a packet
+// in place. The caller must call fixChecksums afterwards.
+func setAddr(pkt []byte, info *packetInfo, src bool, addr netip.Addr) {
+	if info.version == 4 {
+		a := addr.As4()
+		if src {
+			copy(pkt[12:16], a[:])
+			info.src = addr
+		} else {
+			copy(pkt[16:20], a[:])
+			info.dst = addr
+		}
+		return
+	}
+	a := addr.As16()
+	if src {
+		copy(pkt[8:24], a[:])
+		info.src = addr
+	} else {
+		copy(pkt[24:40], a[:])
+		info.dst = addr
+	}
+}
+
+// buildIPHeader writes an IP header for a packet of the given transport
+// protocol into dst and returns the header length.
+func buildIPHeader(dst []byte, src, to netip.Addr, proto uint8, payloadLen int) int {
+	if src.Is4() {
+		dst[0] = 0x45
+		dst[1] = 0
+		binary.BigEndian.PutUint16(dst[2:4], uint16(ipv4HeaderMinLen+payloadLen))
+		binary.BigEndian.PutUint16(dst[4:6], 0)
+		binary.BigEndian.PutUint16(dst[6:8], 0x4000) // don't fragment
+		dst[8] = 64
+		dst[9] = proto
+		dst[10], dst[11] = 0, 0
+		s := src.As4()
+		d := to.As4()
+		copy(dst[12:16], s[:])
+		copy(dst[16:20], d[:])
+		binary.BigEndian.PutUint16(dst[10:12], checksumFold(checksumAdd(0, dst[:ipv4HeaderMinLen])))
+		return ipv4HeaderMinLen
+	}
+	dst[0] = 0x60
+	dst[1], dst[2], dst[3] = 0, 0, 0
+	binary.BigEndian.PutUint16(dst[4:6], uint16(payloadLen))
+	dst[6] = proto
+	dst[7] = 64
+	s := src.As16()
+	d := to.As16()
+	copy(dst[8:24], s[:])
+	copy(dst[24:40], d[:])
+	return ipv6HeaderLen
+}
+
+func ipHeaderLen(addr netip.Addr) int {
+	if addr.Is4() {
+		return ipv4HeaderMinLen
+	}
+	return ipv6HeaderLen
+}
+
+// buildUDPPacket creates a complete IP/UDP packet. headroom bytes are reserved
+// in front of the packet (the returned slice starts at the headroom).
+func buildUDPPacket(headroom int, src netip.AddrPort, dst netip.AddrPort, payload []byte) []byte {
+	hl := ipHeaderLen(src.Addr())
+	buf := make([]byte, headroom+hl+udpHeaderLen+len(payload))
+	pkt := buf[headroom:]
+	buildIPHeader(pkt, src.Addr(), dst.Addr(), protoUDP, udpHeaderLen+len(payload))
+	udp := pkt[hl:]
+	binary.BigEndian.PutUint16(udp[0:2], src.Port())
+	binary.BigEndian.PutUint16(udp[2:4], dst.Port())
+	binary.BigEndian.PutUint16(udp[4:6], uint16(udpHeaderLen+len(payload)))
+	copy(udp[udpHeaderLen:], payload)
+	sum := pseudoHeaderSum(src.Addr(), dst.Addr(), protoUDP, len(udp))
+	cs := checksumFold(checksumAdd(sum, udp))
+	if cs == 0 {
+		cs = 0xffff
+	}
+	binary.BigEndian.PutUint16(udp[6:8], cs)
+	return buf
+}
+
+// buildTCPReset creates a RST(+ACK) answering the given TCP segment.
+func buildTCPReset(headroom int, pkt []byte, info *packetInfo) []byte {
+	l4 := pkt[info.ipHdrLen:info.totalLen]
+	seq := binary.BigEndian.Uint32(l4[4:8])
+	ack := binary.BigEndian.Uint32(l4[8:12])
+	dataOff := int(l4[12]>>4) * 4
+	payloadLen := len(l4) - dataOff
+	if payloadLen < 0 {
+		payloadLen = 0
+	}
+	hl := ipHeaderLen(info.dst)
+	buf := make([]byte, headroom+hl+tcpHeaderMinLen)
+	out := buf[headroom:]
+	buildIPHeader(out, info.dst, info.src, protoTCP, tcpHeaderMinLen)
+	tcp := out[hl:]
+	binary.BigEndian.PutUint16(tcp[0:2], info.dstPort)
+	binary.BigEndian.PutUint16(tcp[2:4], info.srcPort)
+	var outSeq, outAck uint32
+	flags := uint8(tcpFlagRST)
+	if info.tcpFlags&tcpFlagACK != 0 {
+		outSeq = ack
+	} else {
+		flags |= tcpFlagACK
+		seg := uint32(payloadLen)
+		if info.tcpFlags&tcpFlagSYN != 0 {
+			seg++
+		}
+		if info.tcpFlags&tcpFlagFIN != 0 {
+			seg++
+		}
+		outAck = seq + seg
+	}
+	binary.BigEndian.PutUint32(tcp[4:8], outSeq)
+	binary.BigEndian.PutUint32(tcp[8:12], outAck)
+	tcp[12] = 5 << 4
+	tcp[13] = flags
+	sum := pseudoHeaderSum(info.dst, info.src, protoTCP, tcpHeaderMinLen)
+	binary.BigEndian.PutUint16(tcp[16:18], checksumFold(checksumAdd(sum, tcp)))
+	return buf
+}
+
+// buildICMPUnreachable creates an ICMP destination unreachable message
+// (administratively prohibited) quoting the original packet.
+func buildICMPUnreachable(headroom int, pkt []byte, info *packetInfo) []byte {
+	quote := pkt[:info.totalLen]
+	if info.version == 4 {
+		if len(quote) > info.ipHdrLen+8 {
+			quote = quote[:info.ipHdrLen+8]
+		}
+		hl := ipv4HeaderMinLen
+		buf := make([]byte, headroom+hl+8+len(quote))
+		out := buf[headroom:]
+		buildIPHeader(out, info.dst, info.src, protoICMP, 8+len(quote))
+		icmp := out[hl:]
+		icmp[0] = 3  // destination unreachable
+		icmp[1] = 13 // communication administratively prohibited
+		copy(icmp[8:], quote)
+		binary.BigEndian.PutUint16(icmp[2:4], checksumFold(checksumAdd(0, icmp)))
+		return buf
+	}
+	if len(quote) > 1232 {
+		quote = quote[:1232]
+	}
+	hl := ipv6HeaderLen
+	buf := make([]byte, headroom+hl+8+len(quote))
+	out := buf[headroom:]
+	buildIPHeader(out, info.dst, info.src, protoICMPv6, 8+len(quote))
+	icmp := out[hl:]
+	icmp[0] = 1 // destination unreachable
+	icmp[1] = 1 // administratively prohibited
+	copy(icmp[8:], quote)
+	sum := pseudoHeaderSum(info.dst, info.src, protoICMPv6, len(icmp))
+	binary.BigEndian.PutUint16(icmp[2:4], checksumFold(checksumAdd(sum, icmp)))
+	return buf
+}
+
+// buildICMPEchoReply creates an echo reply from dst to src with the given
+// identifier/sequence and payload.
+func buildICMPEchoReply(headroom int, from, to netip.Addr, id, seq uint16, payload []byte) []byte {
+	hl := ipHeaderLen(from)
+	buf := make([]byte, headroom+hl+8+len(payload))
+	out := buf[headroom:]
+	if from.Is4() {
+		buildIPHeader(out, from, to, protoICMP, 8+len(payload))
+		icmp := out[hl:]
+		icmp[0] = 0
+		icmp[1] = 0
+		binary.BigEndian.PutUint16(icmp[4:6], id)
+		binary.BigEndian.PutUint16(icmp[6:8], seq)
+		copy(icmp[8:], payload)
+		binary.BigEndian.PutUint16(icmp[2:4], checksumFold(checksumAdd(0, icmp)))
+		return buf
+	}
+	buildIPHeader(out, from, to, protoICMPv6, 8+len(payload))
+	icmp := out[hl:]
+	icmp[0] = 129
+	icmp[1] = 0
+	binary.BigEndian.PutUint16(icmp[4:6], id)
+	binary.BigEndian.PutUint16(icmp[6:8], seq)
+	copy(icmp[8:], payload)
+	sum := pseudoHeaderSum(from, to, protoICMPv6, len(icmp))
+	binary.BigEndian.PutUint16(icmp[2:4], checksumFold(checksumAdd(sum, icmp)))
+	return buf
+}
diff --git a/router/router.go b/router/router.go
new file mode 100644
index 0000000..16a2f6f
--- /dev/null
+++ b/router/router.go
@@ -0,0 +1,451 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+// Package router implements rule based split tunnelling for AmneziaWG.
+//
+// The Router wraps the TUN device of a WireGuard device. When enabled, all
+// traffic of the host is routed into the TUN device and the router decides,
+// per connection, whether it goes through the tunnel ("proxy"), leaves the
+// host directly ("direct"), or is rejected ("block"). Decisions are based on
+// ordered rules made of domain matchers (full/domain/keyword/regexp, as in
+// Xray) and IP prefixes. Domain rules are applied by intercepting DNS: the
+// answers are used to associate destination addresses with the rule that
+// matched the queried name. Direct TCP connections are terminated in a
+// userspace TCP/IP stack and re-originated with sockets that bypass the
+// tunnel; direct UDP is relayed at the packet level.
+package router
+
+import (
+	"context"
+	"errors"
+	"net/netip"
+	"os"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"github.com/amnezia-vpn/amneziawg-go/v3/tun"
+)
+
+// injectHeadroom is the offset used for packets the router writes to the
+// TUN device itself. It must be at least as large as any TUN
+// implementation's header requirement (4 bytes on Darwin, 10 bytes of
+// virtio-net header on Linux) and matches MessageTransportOffsetContent.
+const injectHeadroom = 16
+
+const (
+	tcpSynFlowTTL    = 30 * time.Second
+	tcpDirectFlowTTL = 2 * time.Hour
+	udpFlowTTL       = 2 * time.Minute
+	sweepInterval    = 30 * time.Second
+)
+
+// Logger is the subset of device.Logger used by the router.
+type Logger struct {
+	Verbosef func(format string, args ...any)
+	Errorf   func(format string, args ...any)
+}
+
+// Router is a tun.Device that applies routing rules to the packets flowing
+// between the OS and a WireGuard device.
+type Router struct {
+	inner tun.Device
+	log   Logger
+
+	// injectOutbound sends a packet into the tunnel (it must copy pkt).
+	injectOutbound func(pkt []byte)
+
+	bypass bypass
+
+	mu     sync.Mutex // serialises Configure/Close
+	state  atomic.Pointer[state]
+	closed atomic.Bool
+	path   string
+}
+
+type state struct {
+	r      *Router
+	cfg    *compiledConfig
+	flows  *flowTable
+	dns    *dnsEngine
+	stack  *netStack
+	udp    *udpForwarder
+	icmp   *icmpForwarder
+	ctx    context.Context
+	cancel context.CancelFunc
+	wg     sync.WaitGroup
+}
+
+// New wraps inner. The router is inactive (a transparent pass-through) until
+// Configure is called with a non-empty configuration.
+func New(inner tun.Device, log Logger, injectOutbound func(pkt []byte)) *Router {
+	if log.Verbosef == nil {
+		log.Verbosef = func(string, ...any) {}
+	}
+	if log.Errorf == nil {
+		log.Errorf = func(string, ...any) {}
+	}
+	return &Router{inner: inner, log: log, injectOutbound: injectOutbound}
+}
+
+// Inner returns the wrapped device.
+func (r *Router) Inner() tun.Device { return r.inner }
+
+// Active reports whether routing rules are applied.
+func (r *Router) Active() bool { return r.state.Load() != nil }
+
+// ConfigPath returns the path of the active configuration file.
+func (r *Router) ConfigPath() string {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	return r.path
+}
+
+// SetBypassInterface sets the interface index used for direct IPv4 (and
+// IPv6 unless SetBypassInterface6 is used) sockets.
+func (r *Router) SetBypassInterface(index uint32) { r.bypass.ifIndex4.Store(index) }
+
+// SetBypassInterface6 sets the interface index used for direct IPv6 sockets.
+func (r *Router) SetBypassInterface6(index uint32) { r.bypass.ifIndex6.Store(index) }
+
+// SetBypassInterfaceName sets the interface name used for direct sockets
+// (Linux: SO_BINDTODEVICE).
+func (r *Router) SetBypassInterfaceName(name string) { r.bypass.setInterfaceName(name) }
+
+// SetBypassMark sets the firewall mark used for direct sockets (Linux).
+func (r *Router) SetBypassMark(mark uint32) { r.bypass.fwmark.Store(mark) }
+
+// Configure loads the configuration file at path and activates the router.
+// An empty path deactivates it.
+func (r *Router) Configure(path string) error {
+	r.mu.Lock()
+	defer r.mu.Unlock()
+	if r.closed.Load() {
+		return os.ErrClosed
+	}
+	if path == "" {
+		r.path = ""
+		if old := r.state.Swap(nil); old != nil {
+			old.close()
+		}
+		r.log.Verbosef("router: disabled")
+		return nil
+	}
+	cfg, err := LoadConfigFile(path)
+	if err != nil {
+		return err
+	}
+	st, err := r.newState(cfg)
+	if err != nil {
+		return err
+	}
+	r.path = path
+	if old := r.state.Swap(st); old != nil {
+		old.close()
+	}
+	r.log.Verbosef("router: enabled with %d rules, default %v", len(cfg.rules), cfg.defaultAction)
+	return nil
+}
+
+func (r *Router) newState(cfg *compiledConfig) (*state, error) {
+	ctx, cancel := context.WithCancel(context.Background())
+	st := &state{r: r, cfg: cfg, flows: newFlowTable(), ctx: ctx, cancel: cancel}
+	st.dns = newDNSEngine(st)
+	st.udp = newUDPForwarder(st)
+	st.icmp = &icmpForwarder{st: st}
+	mtu, err := r.inner.MTU()
+	if err != nil || mtu <= 0 {
+		mtu = 1420
+	}
+	ns, err := newNetStack(st, mtu)
+	if err != nil {
+		cancel()
+		return nil, err
+	}
+	st.stack = ns
+	if cfg.directDoH != nil {
+		cfg.directDoH.start(&r.bypass)
+	}
+	st.wg.Add(1)
+	go st.sweepLoop()
+	return st, nil
+}
+
+func (st *state) close() {
+	st.cancel()
+	st.stack.close()
+	st.udp.close()
+	st.wg.Wait()
+	st.cfg.directDoH.close()
+}
+
+func (st *state) sweepLoop() {
+	defer st.wg.Done()
+	t := time.NewTicker(sweepInterval)
+	defer t.Stop()
+	for {
+		select {
+		case <-st.ctx.Done():
+			return
+		case now := <-t.C:
+			n := now.UnixNano()
+			st.flows.sweep(n)
+			st.dns.sweep(n)
+		}
+	}
+}
+
+func (st *state) bypassAvailable() bool {
+	return st.r.bypass.available(st.cfg.bypassOS)
+}
+
+// decide computes the action for a new flow towards dst.
+func (st *state) decide(dst netip.Addr, now int64) Action {
+	learned := st.dns.lookupLearned(dst, now)
+	a := st.cfg.decide(dst, learned)
+	if a == ActionDirect && !st.bypassAvailable() {
+		// Without a way to leave the tunnel a direct connection would loop
+		// back into the router; keep it in the tunnel instead.
+		a = ActionProxy
+	}
+	if a == ActionProxy && st.cfg.rejectV6Proxy && dst.Is6() && !dst.Is4In6() {
+		// The tunnel has no IPv6: refuse at once so that applications fall
+		// back to IPv4 instead of waiting for a black-holed connection.
+		return ActionBlock
+	}
+	return a
+}
+
+// writeInjected writes a packet generated by the router to the OS. buf must
+// have injectHeadroom bytes of headroom in front of the packet.
+func (r *Router) writeInjected(buf []byte) {
+	if len(buf) <= injectHeadroom || r.closed.Load() {
+		return
+	}
+	if _, err := r.inner.Write([][]byte{buf}, injectHeadroom); err != nil && !errors.Is(err, os.ErrClosed) {
+		r.log.Verbosef("router: failed to write packet to TUN: %v", err)
+	}
+}
+
+// writeInjectedBatch writes several router generated packets to the OS.
+func (r *Router) writeInjectedBatch(bufs [][]byte) {
+	if len(bufs) == 0 || r.closed.Load() {
+		return
+	}
+	if _, err := r.inner.Write(bufs, injectHeadroom); err != nil && !errors.Is(err, os.ErrClosed) {
+		r.log.Verbosef("router: failed to write packets to TUN: %v", err)
+	}
+}
+
+// handleOutbound decides the fate of a packet read from the OS. It returns
+// true if the packet must be sent through the tunnel.
+func (st *state) handleOutbound(pkt []byte) bool {
+	var info packetInfo
+	if !parsePacket(pkt, &info) {
+		return true
+	}
+	now := time.Now().UnixNano()
+
+	if info.fragment && !info.transport {
+		// Non-first fragment: route by destination only.
+		switch st.decide(info.dst, now) {
+		case ActionProxy:
+			return true
+		case ActionDirect:
+			if info.proto == protoTCP {
+				st.stack.inject(pkt[:info.totalLen])
+			}
+		}
+		return false
+	}
+
+	switch info.proto {
+	case protoUDP:
+		if info.dstPort == 53 && !info.fragment {
+			return st.dns.handleQuery(pkt[:info.totalLen], &info)
+		}
+		key := flowKey{proto: protoUDP, src: netip.AddrPortFrom(info.src, info.srcPort), dst: netip.AddrPortFrom(info.dst, info.dstPort)}
+		action, ok := st.flows.get(key, now)
+		if !ok {
+			action = st.decide(info.dst, now)
+			st.flows.put(key, action, udpFlowTTL, now)
+		}
+		switch action {
+		case ActionProxy:
+			if st.cfg.blockQUIC && info.dstPort == 443 {
+				st.r.writeInjected(buildICMPUnreachable(injectHeadroom, pkt, &info))
+				return false
+			}
+			return true
+		case ActionDirect:
+			st.udp.handle(pkt, &info)
+		case ActionBlock:
+			st.r.writeInjected(buildICMPUnreachable(injectHeadroom, pkt, &info))
+		}
+		return false
+
+	case protoTCP:
+		if st.cfg.isListenAddr(info.dst) {
+			// DNS over TCP to the router itself.
+			st.stack.inject(pkt[:info.totalLen])
+			return false
+		}
+		key := flowKey{proto: protoTCP, src: netip.AddrPortFrom(info.src, info.srcPort), dst: netip.AddrPortFrom(info.dst, info.dstPort)}
+		syn := info.tcpFlags&tcpFlagSYN != 0 && info.tcpFlags&tcpFlagACK == 0
+		if !syn {
+			if st.flows.directTCP.Load() == 0 {
+				return true
+			}
+			if action, ok := st.flows.get(key, now); ok && action == ActionDirect {
+				st.stack.inject(pkt[:info.totalLen])
+				return false
+			}
+			return true
+		}
+		action, ok := st.flows.get(key, now)
+		if !ok {
+			action = st.decide(info.dst, now)
+			switch action {
+			case ActionDirect:
+				st.flows.put(key, action, tcpDirectFlowTTL, now)
+			case ActionProxy:
+				st.flows.put(key, action, tcpSynFlowTTL, now)
+			}
+		}
+		switch action {
+		case ActionProxy:
+			return true
+		case ActionDirect:
+			st.stack.inject(pkt[:info.totalLen])
+		case ActionBlock:
+			st.r.writeInjected(buildTCPReset(injectHeadroom, pkt, &info))
+		}
+		return false
+
+	case protoICMP, protoICMPv6:
+		isEcho := (info.proto == protoICMP && info.icmpType == 8) || (info.proto == protoICMPv6 && info.icmpType == 128)
+		if info.proto == protoICMPv6 && info.icmpType >= 133 && info.icmpType <= 137 {
+			// Neighbour discovery / router solicitation: leave to the tunnel.
+			return true
+		}
+		switch st.decide(info.dst, now) {
+		case ActionProxy:
+			return true
+		case ActionDirect:
+			if isEcho {
+				st.icmp.handleEcho(pkt, &info)
+			}
+		case ActionBlock:
+			if isEcho {
+				st.r.writeInjected(buildICMPUnreachable(injectHeadroom, pkt, &info))
+			}
+		}
+		return false
+
+	default:
+		return st.decide(info.dst, now) == ActionProxy
+	}
+}
+
+// handleInbound inspects a packet coming from the tunnel before it is
+// written to the OS. It returns false if the packet must be dropped.
+func (st *state) handleInbound(pkt []byte) bool {
+	if len(pkt) < ipv4HeaderMinLen {
+		return true
+	}
+	// Fast path: only UDP from port 53 is of interest.
+	var proto uint8
+	var ihl int
+	switch pkt[0] >> 4 {
+	case 4:
+		proto = pkt[9]
+		ihl = int(pkt[0]&0x0f) * 4
+	case 6:
+		if len(pkt) < ipv6HeaderLen {
+			return true
+		}
+		proto = pkt[6]
+		ihl = ipv6HeaderLen
+	default:
+		return true
+	}
+	if proto != protoUDP || len(pkt) < ihl+udpHeaderLen {
+		return true
+	}
+	if pkt[ihl] != 0 || pkt[ihl+1] != 53 {
+		return true
+	}
+	var info packetInfo
+	if !parsePacket(pkt, &info) || info.fragment || info.proto != protoUDP {
+		return true
+	}
+	return st.dns.handleResponse(pkt[:info.totalLen], &info)
+}
+
+// Read implements tun.Device. Packets that are handled by the router are
+// reported with a size of zero, which the WireGuard device skips.
+func (r *Router) Read(bufs [][]byte, sizes []int, offset int) (int, error) {
+	n, err := r.inner.Read(bufs, sizes, offset)
+	st := r.state.Load()
+	if st == nil {
+		return n, err
+	}
+	for i := 0; i < n; i++ {
+		if sizes[i] <= 0 {
+			continue
+		}
+		if !st.handleOutbound(bufs[i][offset : offset+sizes[i]]) {
+			sizes[i] = 0
+		}
+	}
+	return n, err
+}
+
+// Write implements tun.Device.
+func (r *Router) Write(bufs [][]byte, offset int) (int, error) {
+	st := r.state.Load()
+	if st == nil {
+		return r.inner.Write(bufs, offset)
+	}
+	var filtered [][]byte
+	for i, buf := range bufs {
+		keep := st.handleInbound(buf[offset:])
+		if !keep && filtered == nil {
+			filtered = make([][]byte, 0, len(bufs))
+			filtered = append(filtered, bufs[:i]...)
+		} else if keep && filtered != nil {
+			filtered = append(filtered, buf)
+		}
+	}
+	if filtered == nil {
+		return r.inner.Write(bufs, offset)
+	}
+	if len(filtered) == 0 {
+		return len(bufs), nil
+	}
+	if _, err := r.inner.Write(filtered, offset); err != nil {
+		return 0, err
+	}
+	return len(bufs), nil
+}
+
+func (r *Router) File() *os.File           { return r.inner.File() }
+func (r *Router) MTU() (int, error)        { return r.inner.MTU() }
+func (r *Router) Name() (string, error)    { return r.inner.Name() }
+func (r *Router) Events() <-chan tun.Event { return r.inner.Events() }
+func (r *Router) BatchSize() int           { return r.inner.BatchSize() }
+
+// Close deactivates the router and closes the wrapped device.
+func (r *Router) Close() error {
+	r.mu.Lock()
+	r.closed.Store(true)
+	old := r.state.Swap(nil)
+	r.mu.Unlock()
+	err := r.inner.Close()
+	if old != nil {
+		old.close()
+	}
+	return err
+}
