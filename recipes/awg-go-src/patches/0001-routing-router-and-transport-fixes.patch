index 0000000..821ef25
--- /dev/null
+++ b/router/icmp_socket_unix.go
@@ -0,0 +1,57 @@
+//go:build darwin || linux
+
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"runtime"
+
+	"golang.org/x/sys/unix"
+)
+
+// openICMPSocket opens an unprivileged ICMP datagram socket (as used by
+// ping) that bypasses the tunnel.
+func (b *bypass) openICMPSocket(v6 bool) (net.PacketConn, error) {
+	family, proto, network := unix.AF_INET, unix.IPPROTO_ICMP, "udp4"
+	if v6 {
+		family, proto, network = unix.AF_INET6, unix.IPPROTO_ICMPV6, "udp6"
+	}
+	fd, err := unix.Socket(family, unix.SOCK_DGRAM, proto)
+	if err != nil {
+		return nil, err
+	}
+	unix.CloseOnExec(fd)
+	f := os.NewFile(uintptr(fd), "icmp")
+	defer f.Close()
+	rc, err := f.SyscallConn()
+	if err != nil {
+		return nil, err
+	}
+	if err := b.control(network, "", rc); err != nil {
+		return nil, err
+	}
+	pc, err := net.FilePacketConn(f)
+	if err != nil {
+		return nil, fmt.Errorf("icmp socket: %w", err)
+	}
+	return pc, nil
+}
+
+// icmpReplyPayload strips the IPv4 header that Darwin includes when reading
+// from ICMP datagram sockets.
+func icmpReplyPayload(b []byte, v6 bool) []byte {
+	if !v6 && (runtime.GOOS == "darwin" || runtime.GOOS == "ios") && len(b) >= ipv4HeaderMinLen && b[0]>>4 == 4 {
+		hl := int(b[0]&0x0f) * 4
+		if hl <= len(b) {
+			return b[hl:]
+		}
+	}
+	return b
+}
