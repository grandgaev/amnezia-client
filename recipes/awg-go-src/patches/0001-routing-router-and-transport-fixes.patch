+// isLiveTransport reports whether packet, interpreted as a transport message,
+// carries an H4 type and a receiver index that belongs to a live keypair.
+// Used to disambiguate packets that *also* match a handshake type because
+// RandomTrailers relaxes the handshake size check to "size > expected".
+func (device *Device) isLiveTransport(packet []byte) bool {
+	padding := int(device.paddings.transport.Load())
+	if len(packet) < padding+MessageTransportSize {
+		return false
+	}
+	var hdr [8]byte
+	copy(hdr[:], packet[padding:padding+8])
+	cip, err := device.HeaderProtectionCipher(packet[:HeaderCipherNonceSize])
+	if err != nil {
+		return false
+	}
+	if cip != nil {
+		cip.XORKeyStream(hdr[:], hdr[:])
+	}
+	if !device.headers.transport.Load().Contains(binary.LittleEndian.Uint32(hdr[0:4])) {
+		return false
+	}
+	return device.indexTable.Lookup(binary.LittleEndian.Uint32(hdr[4:8])).keypair != nil
+}
