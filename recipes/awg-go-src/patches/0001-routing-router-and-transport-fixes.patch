+		DefaultAction: "proxy",
+		Rules: []RuleConfig{
+			{Action: "block", Domains: []string{"domain:ads.example"}, IPs: []string{"203.0.113.66"}},
+			{Action: "proxy", Domains: []string{"domain:blocked.example"}},
+			{Action: "direct", Domains: []string{"domain:ru"}, IPs: []string{"127.0.0.0/8"}},
+		},
+		DNS: DNSConfig{
+			Listen: []string{vip.Addr().String()},
+			Remote: []string{remote.Addr().String()},
+			Hosts:  map[string][]string{"static.example": {"192.0.2.10"}},
+		},
+		Bypass: "os",
+	}
+}
+
+func TestRouterRemoteDNSAndLearning(t *testing.T) {
+	h := newHarness(t, baseConfig())
+
+	q := dnsQuery(t, 0x1111, "www.blocked.example.", dnsmessage.TypeA)
+	h.fromOS(buildUDPPacket(0, client, vip, q))
+	out := h.expectToTunnel(time.Second)
+	info, payload := udpPayload(t, out)
+	if info.dst != remote.Addr() || info.dstPort != 53 || info.src != client.Addr() {
+		t.Fatalf("query not redirected to remote DNS: %+v", info)
+	}
+	verifyChecksums(t, out)
+	if string(payload) != string(q) {
+		t.Fatal("payload changed")
+	}
+
+	// Response from the remote resolver through the tunnel.
+	resp := dnsAnswer(t, q, "93.184.216.34")
+	h.fromTunnel(buildUDPPacket(0, remote, client, resp))
+	back := h.expectToOS(time.Second)
+	binfo, bpayload := udpPayload(t, back)
+	if binfo.src != vip.Addr() || binfo.srcPort != 53 || binfo.dst != client.Addr() {
+		t.Fatalf("response source not restored: %+v", binfo)
+	}
+	verifyChecksums(t, back)
+	if string(bpayload) != string(resp) {
+		t.Fatal("response payload changed")
+	}
+	st := h.r.state.Load()
+	if rule := st.dns.lookupLearned(netip.MustParseAddr("93.184.216.34"), time.Now().UnixNano()); rule != 1 {
+		t.Fatalf("expected address learned for rule 1, got %d", rule)
+	}
+}
+
+func TestRouterBlockAndHosts(t *testing.T) {
+	h := newHarness(t, baseConfig())
+
+	q := dnsQuery(t, 0x2222, "tracker.ads.example.", dnsmessage.TypeA)
+	h.fromOS(buildUDPPacket(0, client, vip, q))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	back := h.expectToOS(time.Second)
+	_, payload := udpPayload(t, back)
+	var p dnsmessage.Parser
+	hdr, err := p.Start(payload)
+	if err != nil || hdr.RCode != dnsmessage.RCodeNameError || hdr.ID != 0x2222 {
+		t.Fatalf("expected NXDOMAIN, got %+v %v", hdr, err)
+	}
+
+	q = dnsQuery(t, 0x3333, "static.example.", dnsmessage.TypeA)
+	h.fromOS(buildUDPPacket(0, client, vip, q))
+	back = h.expectToOS(time.Second)
+	_, payload = udpPayload(t, back)
+	p = dnsmessage.Parser{}
+	p.Start(payload)
+	p.SkipAllQuestions()
+	a, err := p.AnswerHeader()
+	if err != nil || a.Type != dnsmessage.TypeA {
+		t.Fatalf("expected A answer: %v", err)
+	}
+	r, _ := p.AResource()
+	if netip.AddrFrom4(r.A) != netip.MustParseAddr("192.0.2.10") {
+		t.Fatalf("unexpected hosts answer %v", r.A)
+	}
+
+	// TCP to a blocked IP is reset.
+	h.fromOS(tcpSyn(client, netip.MustParseAddrPort("203.0.113.66:443")))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	rst := h.expectToOS(time.Second)
+	var rinfo packetInfo
+	parsePacket(rst, &rinfo)
+	if rinfo.proto != protoTCP || rinfo.tcpFlags&tcpFlagRST == 0 {
+		t.Fatalf("expected RST, got %+v", rinfo)
+	}
+}
+
+func TestRouterDefaultProxyForwards(t *testing.T) {
+	h := newHarness(t, baseConfig())
+	syn := tcpSyn(client, netip.MustParseAddrPort("8.8.8.8:443"))
+	h.fromOS(syn)
+	out := h.expectToTunnel(time.Second)
