diff --git a/router/bypass_windows.go b/router/bypass_windows.go
new file mode 100644
index 0000000..4a4a6cc
--- /dev/null
+++ b/router/bypass_windows.go
@@ -0,0 +1,41 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"encoding/binary"
+	"strings"
+	"unsafe"
+
+	"golang.org/x/sys/windows"
+)
+
+const (
+	sockoptIPUnicastIf   = 31 // IP_UNICAST_IF
+	sockoptIPv6UnicastIf = 31 // IPV6_UNICAST_IF
+)
+
+func (b *bypass) bindSocket(network string, fd uintptr) error {
+	if strings.HasSuffix(network, "6") {
+		idx := b.ifIndex6.Load()
+		if idx == 0 {
+			idx = b.ifIndex4.Load()
+		}
+		if idx == 0 {
+			return nil
+		}
+		return windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IPV6, sockoptIPv6UnicastIf, int(idx))
+	}
+	idx := b.ifIndex4.Load()
+	if idx == 0 {
+		return nil
+	}
+	// IP_UNICAST_IF expects the index in network byte order.
+	var be [4]byte
+	binary.BigEndian.PutUint32(be[:], idx)
+	v := *(*uint32)(unsafe.Pointer(&be[0]))
+	return windows.SetsockoptInt(windows.Handle(fd), windows.IPPROTO_IP, sockoptIPUnicastIf, int(v))
+}
