diff --git a/router/matcher.go b/router/matcher.go
new file mode 100644
index 0000000..7645070
--- /dev/null
+++ b/router/matcher.go
@@ -0,0 +1,301 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"encoding/binary"
+	"fmt"
+	"net/netip"
+	"regexp"
+	"slices"
+	"strings"
+)
+
+// hash64 is FNV-1a. Domain sets store only hashes to keep the memory
+// footprint small (geosite categories can hold hundreds of thousands of
+// entries, and the iOS network extension has a hard memory limit).
+func hash64(s string) uint64 {
+	const (
+		offset = 14695981039346656037
+		prime  = 1099511628211
+	)
+	h := uint64(offset)
+	for i := 0; i < len(s); i++ {
+		h ^= uint64(s[i])
+		h *= prime
+	}
+	return h
+}
+
+// DomainSet matches domain names against full, suffix, keyword and regexp
+// entries, using the syntax of Xray routing rules:
+//
+//	full:example.com    exact match
+//	domain:example.com  example.com and all of its subdomains
+//	keyword:example     substring match
+//	regexp:^ex.*\.com$  regular expression
+type DomainSet struct {
+	full     []uint64
+	suffix   []uint64
+	keywords []string
+	regexps  []*regexp.Regexp
+}
+
+// NormalizeDomain lowercases a domain and strips a trailing dot.
+func NormalizeDomain(d string) string {
+	d = strings.TrimSpace(d)
+	d = strings.TrimSuffix(d, ".")
+	return strings.ToLower(d)
+}
+
+func (s *DomainSet) add(entry string) error {
+	entry = strings.TrimSpace(entry)
+	if entry == "" {
+		return nil
+	}
+	kind := "domain"
+	value := entry
+	if i := strings.IndexByte(entry, ':'); i > 0 {
+		switch entry[:i] {
+		case "full", "domain", "keyword", "regexp":
+			kind = entry[:i]
+			value = entry[i+1:]
+		}
+	}
+	switch kind {
+	case "full":
+		value = NormalizeDomain(value)
+		if value != "" {
+			s.full = append(s.full, hash64(value))
+		}
+	case "domain":
+		value = NormalizeDomain(strings.TrimPrefix(value, "."))
+		if value != "" {
+			s.suffix = append(s.suffix, hash64(value))
+		}
+	case "keyword":
+		value = strings.ToLower(strings.TrimSpace(value))
+		if value != "" {
+			s.keywords = append(s.keywords, value)
+		}
+	case "regexp":
+		re, err := regexp.Compile(value)
+		if err != nil {
+			return fmt.Errorf("invalid regexp %q: %w", value, err)
+		}
+		s.regexps = append(s.regexps, re)
+	}
+	return nil
+}
+
+func (s *DomainSet) finalize() {
+	slices.Sort(s.full)
+	s.full = slices.Compact(s.full)
+	slices.Sort(s.suffix)
+	s.suffix = slices.Compact(s.suffix)
+}
+
+// Empty reports whether the set has no entries.
+func (s *DomainSet) Empty() bool {
+	return s == nil || (len(s.full) == 0 && len(s.suffix) == 0 && len(s.keywords) == 0 && len(s.regexps) == 0)
+}
+
+func containsHash(list []uint64, h uint64) bool {
+	_, found := slices.BinarySearch(list, h)
+	return found
+}
+
+// Match reports whether a normalized domain name matches the set.
+func (s *DomainSet) Match(name string) bool {
+	if s == nil || name == "" {
+		return false
+	}
+	if len(s.full) > 0 && containsHash(s.full, hash64(name)) {
+		return true
+	}
+	if len(s.suffix) > 0 {
+		d := name
+		for {
+			if containsHash(s.suffix, hash64(d)) {
+				return true
+			}
+			i := strings.IndexByte(d, '.')
+			if i < 0 {
+				break
+			}
+			d = d[i+1:]
+		}
+	}
+	for _, k := range s.keywords {
+		if strings.Contains(name, k) {
+			return true
+		}
+	}
+	for _, re := range s.regexps {
+		if re.MatchString(name) {
+			return true
+		}
+	}
+	return false
+}
+
+type range4 struct{ lo, hi uint32 }
+
+type range6 struct{ lo, hi [16]byte }
+
+// IPSet is an immutable set of IP prefixes supporting fast lookups.
+type IPSet struct {
+	v4 []range4
+	v6 []range6
+}
+
+func (s *IPSet) Empty() bool {
+	return s == nil || (len(s.v4) == 0 && len(s.v6) == 0)
+}
+
+// ParsePrefixOrAddr accepts "1.2.3.4", "1.2.3.0/24", "2001:db8::/32".
+func ParsePrefixOrAddr(v string) (netip.Prefix, error) {
+	v = strings.TrimSpace(v)
+	if strings.Contains(v, "/") {
+		p, err := netip.ParsePrefix(v)
+		if err != nil {
+			return netip.Prefix{}, err
+		}
+		return p.Masked(), nil
+	}
+	a, err := netip.ParseAddr(v)
+	if err != nil {
+		return netip.Prefix{}, err
+	}
+	return netip.PrefixFrom(a, a.BitLen()), nil
+}
+
+func buildIPSet(prefixes []netip.Prefix) *IPSet {
+	s := &IPSet{}
+	var r4 []range4
+	var r6 []range6
+	for _, p := range prefixes {
+		p = p.Masked()
+		addr := p.Addr().Unmap()
+		bits := p.Bits()
+		if addr.Is4() {
+			if p.Addr().Is4In6() {
+				bits -= 96
+				if bits < 0 {
+					bits = 0
+				}
+			}
+			a := addr.As4()
+			lo := binary.BigEndian.Uint32(a[:])
+			var hi uint32
+			if bits == 0 {
+				lo, hi = 0, ^uint32(0)
+			} else {
+				hi = lo | (^uint32(0) >> uint(bits))
+			}
+			r4 = append(r4, range4{lo, hi})
+		} else {
+			lo := addr.As16()
+			hi := lo
+			for i := bits; i < 128; i++ {
+				hi[i/8] |= 1 << uint(7-i%8)
+			}
+			r6 = append(r6, range6{lo, hi})
+		}
+	}
+	slices.SortFunc(r4, func(a, b range4) int {
+		if a.lo < b.lo {
+			return -1
+		}
+		if a.lo > b.lo {
+			return 1
+		}
+		return 0
+	})
+	for _, r := range r4 {
+		if n := len(s.v4); n > 0 && (r.lo <= s.v4[n-1].hi || (s.v4[n-1].hi != ^uint32(0) && r.lo == s.v4[n-1].hi+1)) {
+			if r.hi > s.v4[n-1].hi {
+				s.v4[n-1].hi = r.hi
+			}
+			continue
+		}
+		s.v4 = append(s.v4, r)
+	}
+	cmp16 := func(a, b [16]byte) int {
+		for i := 0; i < 16; i++ {
+			if a[i] != b[i] {
+				if a[i] < b[i] {
+					return -1
+				}
+				return 1
+			}
+		}
+		return 0
+	}
+	slices.SortFunc(r6, func(a, b range6) int { return cmp16(a.lo, b.lo) })
+	for _, r := range r6 {
+		if n := len(s.v6); n > 0 && cmp16(r.lo, s.v6[n-1].hi) <= 0 {
+			if cmp16(r.hi, s.v6[n-1].hi) > 0 {
+				s.v6[n-1].hi = r.hi
+			}
+			continue
+		}
+		s.v6 = append(s.v6, r)
+	}
+	return s
+}
+
+// Contains reports whether addr belongs to the set.
+func (s *IPSet) Contains(addr netip.Addr) bool {
+	if s == nil {
+		return false
+	}
+	addr = addr.Unmap()
+	if addr.Is4() {
+		if len(s.v4) == 0 {
+			return false
+		}
+		a := addr.As4()
+		v := binary.BigEndian.Uint32(a[:])
+		i, _ := slices.BinarySearchFunc(s.v4, v, func(r range4, t uint32) int {
+			if r.hi < t {
+				return -1
+			}
+			if r.lo > t {
+				return 1
+			}
+			return 0
+		})
+		return i < len(s.v4) && s.v4[i].lo <= v && v <= s.v4[i].hi
+	}
+	if len(s.v6) == 0 {
+		return false
+	}
+	v := addr.As16()
+	i, found := slices.BinarySearchFunc(s.v6, v, func(r range6, t [16]byte) int {
+		if lessEq16(r.hi, t) && r.hi != t {
+			return -1
+		}
+		if less16(t, r.lo) {
+			return 1
+		}
+		return 0
+	})
+	return found && i < len(s.v6)
+}
+
+func less16(a, b [16]byte) bool {
+	for i := 0; i < 16; i++ {
+		if a[i] != b[i] {
+			return a[i] < b[i]
+		}
+	}
+	return false
+}
+
+func lessEq16(a, b [16]byte) bool {
+	return a == b || less16(a, b)
+}
diff --git a/router/netstack.go b/router/netstack.go
new file mode 100644
index 0000000..6521508
--- /dev/null
+++ b/router/netstack.go
@@ -0,0 +1,275 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"io"
+	"net"
+	"net/netip"
+	"sync"
+	"time"
+
+	"gvisor.dev/gvisor/pkg/buffer"
+	"gvisor.dev/gvisor/pkg/tcpip"
+	"gvisor.dev/gvisor/pkg/tcpip/adapters/gonet"
+	"gvisor.dev/gvisor/pkg/tcpip/header"
+	"gvisor.dev/gvisor/pkg/tcpip/link/channel"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv4"
+	"gvisor.dev/gvisor/pkg/tcpip/network/ipv6"
+	"gvisor.dev/gvisor/pkg/tcpip/stack"
+	"gvisor.dev/gvisor/pkg/tcpip/transport/tcp"
+	"gvisor.dev/gvisor/pkg/waiter"
+)
+
+const (
+	tcpMaxInFlight     = 1024
+	tcpHalfCloseLinger = 2 * time.Minute
+	relayBufferSize    = 16 * 1024
+)
+
+var relayBufPool = sync.Pool{New: func() any {
+	b := make([]byte, relayBufferSize)
+	return &b
+}}
+
+// netStack terminates TCP connections that must leave the tunnel directly
+// (and DNS over TCP addressed to the router) in a userspace TCP/IP stack,
+// and re-originates them with sockets that bypass the tunnel.
+type netStack struct {
+	st    *state
+	stack *stack.Stack
+	ep    *channel.Endpoint
+	wg    sync.WaitGroup
+}
+
+func newNetStack(st *state, mtu int) (*netStack, error) {
+	s := stack.New(stack.Options{
+		NetworkProtocols:   []stack.NetworkProtocolFactory{ipv4.NewProtocol, ipv6.NewProtocol},
+		TransportProtocols: []stack.TransportProtocolFactory{tcp.NewProtocol},
+	})
+	ep := channel.New(512, uint32(mtu), "")
+	// Packets come from the local OS; do not waste time verifying checksums.
+	ep.LinkEPCapabilities |= stack.CapabilityRXChecksumOffload
+
+	ns := &netStack{st: st, stack: s, ep: ep}
+
+	sack := tcpip.TCPSACKEnabled(true)
+	s.SetTransportProtocolOption(tcp.ProtocolNumber, &sack)
+	rcv := tcpip.TCPReceiveBufferSizeRangeOption{Min: 4 << 10, Default: tcpBufferDefault, Max: tcpBufferMax}
+	s.SetTransportProtocolOption(tcp.ProtocolNumber, &rcv)
+	snd := tcpip.TCPSendBufferSizeRangeOption{Min: 4 << 10, Default: tcpBufferDefault, Max: tcpBufferMax}
+	s.SetTransportProtocolOption(tcp.ProtocolNumber, &snd)
+
+	if err := s.CreateNIC(1, ep); err != nil {
+		s.Close()
+		return nil, errors.New(err.String())
+	}
+	if err := s.SetPromiscuousMode(1, true); err != nil {
+		s.Close()
+		return nil, errors.New(err.String())
+	}
+	if err := s.SetSpoofing(1, true); err != nil {
+		s.Close()
+		return nil, errors.New(err.String())
+	}
+	s.SetRouteTable([]tcpip.Route{
+		{Destination: header.IPv4EmptySubnet, NIC: 1},
+		{Destination: header.IPv6EmptySubnet, NIC: 1},
+	})
+
+	fwd := tcp.NewForwarder(s, 0, tcpMaxInFlight, ns.handleTCP)
+	s.SetTransportProtocolHandler(tcp.ProtocolNumber, fwd.HandlePacket)
+
+	ns.wg.Add(1)
+	go ns.outputLoop()
+	return ns, nil
+}
+
+func (ns *netStack) close() {
+	ns.stack.Close()
+	ns.ep.Close()
+	ns.wg.Wait()
+	ns.stack.Wait()
+}
+
+// inject hands a packet read from the OS to the userspace stack.
+func (ns *netStack) inject(pkt []byte) {
+	var proto tcpip.NetworkProtocolNumber
+	switch pkt[0] >> 4 {
+	case 4:
+		proto = header.IPv4ProtocolNumber
+	case 6:
+		proto = header.IPv6ProtocolNumber
+	default:
+		return
+	}
+	pkb := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(pkt)})
+	ns.ep.InjectInbound(proto, pkb)
+	pkb.DecRef()
+}
+
+func (ns *netStack) outputLoop() {
+	defer ns.wg.Done()
+	bufs := make([][]byte, 0, outputBatchSize)
+	for {
+		pkt := ns.ep.ReadContext(ns.st.ctx)
+		if pkt == nil {
+			return
+		}
+		bufs = append(bufs[:0], packetToBuffer(pkt))
+		// Drain whatever else is queued so the TUN device can write (and on
+		// Linux coalesce) a whole batch at once.
+		for len(bufs) < outputBatchSize {
+			more := ns.ep.Read()
+			if more == nil {
+				break
+			}
+			bufs = append(bufs, packetToBuffer(more))
+		}
+		ns.st.r.writeInjectedBatch(bufs)
+	}
+}
+
+func packetToBuffer(pkt *stack.PacketBuffer) []byte {
+	buf := make([]byte, injectHeadroom+pkt.Size())
+	off := injectHeadroom
+	for _, s := range pkt.AsSlices() {
+		off += copy(buf[off:], s)
+	}
+	pkt.DecRef()
+	return buf[:off]
+}
+
+func addrFromTcpip(a tcpip.Address) netip.Addr {
+	ip, _ := netip.AddrFromSlice(a.AsSlice())
+	return ip
+}
+
+func (ns *netStack) handleTCP(r *tcp.ForwarderRequest) {
+	id := r.ID()
+	dst := netip.AddrPortFrom(addrFromTcpip(id.LocalAddress), id.LocalPort)
+	src := netip.AddrPortFrom(addrFromTcpip(id.RemoteAddress), id.RemotePort)
+	key := flowKey{proto: protoTCP, src: src, dst: dst}
+
+	if ns.st.cfg.isListenAddr(dst.Addr()) {
+		if dst.Port() != 53 {
+			r.Complete(true)
+			return
+		}
+		var wq waiter.Queue
+		ep, err := r.CreateEndpoint(&wq)
+		if err != nil {
+			r.Complete(true)
+			return
+		}
+		r.Complete(false)
+		conn := gonet.NewTCPConn(&wq, ep)
+		ns.wg.Add(1)
+		go func() {
+			defer ns.wg.Done()
+			ns.serveDNS(conn, src.Addr())
+		}()
+		return
+	}
+
+	ns.wg.Add(1)
+	go func() {
+		defer ns.wg.Done()
+		defer ns.st.flows.remove(key)
+		out, err := ns.st.r.bypass.dialTCP(ns.st.ctx, dst)
+		if err != nil {
+			ns.st.r.log.Verbosef("router: direct connect to %v failed: %v", dst, err)
+			r.Complete(true)
+			return
+		}
+		var wq waiter.Queue
+		ep, terr := r.CreateEndpoint(&wq)
+		if terr != nil {
+			out.Close()
+			r.Complete(true)
+			return
+		}
+		r.Complete(false)
+		ep.SocketOptions().SetKeepAlive(true)
+		in := gonet.NewTCPConn(&wq, ep)
+		relayTCP(ns.st.ctx, in, out)
+	}()
+}
+
+type closeWriter interface {
+	CloseWrite() error
+}
+
+func relayTCP(ctx context.Context, a, b net.Conn) {
+	done := make(chan struct{}, 2)
+	cp := func(dst, src net.Conn) {
+		bufp := relayBufPool.Get().(*[]byte)
+		io.CopyBuffer(dst, src, *bufp)
+		relayBufPool.Put(bufp)
+		if cw, ok := dst.(closeWriter); ok {
+			cw.CloseWrite()
+		} else {
+			dst.Close()
+		}
+		done <- struct{}{}
+	}
+	go cp(a, b)
+	go cp(b, a)
+	select {
+	case <-done:
+	case <-ctx.Done():
+		a.Close()
+		b.Close()
+		<-done
+	}
+	// One direction finished; give the other some time to drain.
+	deadline := time.Now().Add(tcpHalfCloseLinger)
+	a.SetDeadline(deadline)
+	b.SetDeadline(deadline)
+	select {
+	case <-done:
+	case <-ctx.Done():
+		a.Close()
+		b.Close()
+		<-done
+	}
+	a.Close()
+	b.Close()
+}
+
+// serveDNS implements DNS over TCP for the router's own addresses.
+func (ns *netStack) serveDNS(conn net.Conn, local netip.Addr) {
+	defer conn.Close()
+	var lenBuf [2]byte
+	for {
+		conn.SetReadDeadline(time.Now().Add(30 * time.Second))
+		if _, err := io.ReadFull(conn, lenBuf[:]); err != nil {
+			return
+		}
+		n := int(binary.BigEndian.Uint16(lenBuf[:]))
+		if n < 12 {
+			return
+		}
+		query := make([]byte, n)
+		if _, err := io.ReadFull(conn, query); err != nil {
+			return
+		}
+		resp := ns.st.dns.resolve(query, local)
+		if resp == nil {
+			return
+		}
+		out := make([]byte, 2+len(resp))
+		binary.BigEndian.PutUint16(out, uint16(len(resp)))
+		copy(out[2:], resp)
+		conn.SetWriteDeadline(time.Now().Add(10 * time.Second))
+		if _, err := conn.Write(out); err != nil {
+			return
+		}
+	}
+}
