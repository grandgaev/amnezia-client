+}
+
+func startDNSServer(t *testing.T, answer string) netip.AddrPort {
+	pc, err := net.ListenPacket("udp4", "127.0.0.1:0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { pc.Close() })
+	go func() {
+		buf := make([]byte, 1500)
+		for {
+			n, addr, err := pc.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			pc.WriteTo(dnsAnswer(t, buf[:n], answer), addr)
+		}
+	}()
+	return netip.MustParseAddrPort(pc.LocalAddr().String())
+}
+
+func hostAddr(t *testing.T) string {
+	addrs, err := net.InterfaceAddrs()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, a := range addrs {
+		if n, ok := a.(*net.IPNet); ok && n.IP.To4() != nil && !n.IP.IsLoopback() {
+			return n.IP.String()
+		}
+	}
+	t.Skip("no non-loopback IPv4 address")
+	return ""
+}
+
+func TestRouterDirectDNSAndTCP(t *testing.T) {
+	host := hostAddr(t)
+	ln, err := net.Listen("tcp4", host+":0")
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer ln.Close()
+	go func() {
+		for {
+			c, err := ln.Accept()
+			if err != nil {
+				return
+			}
+			c.Write([]byte("hi"))
+			c.Close()
+		}
+	}()
+	cfg := baseConfig()
+	dnsSrv := startDNSServer(t, host)
+	cfg.DNS.Direct = []string{dnsSrv.String()}
+	h := newHarness(t, cfg)
+
+	q := dnsQuery(t, 0x4444, "yandex.ru.", dnsmessage.TypeA)
+	h.fromOS(buildUDPPacket(0, client, vip, q))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	back := h.expectToOS(2 * time.Second)
+	binfo, _ := udpPayload(t, back)
+	if binfo.src != vip.Addr() {
+		t.Fatalf("direct answer has wrong source %v", binfo.src)
+	}
+	st := h.r.state.Load()
+	if rule := st.dns.lookupLearned(netip.MustParseAddr(host), time.Now().UnixNano()); rule != 2 {
+		t.Fatalf("expected %s learned for the direct rule, got %d", host, rule)
+	}
+
+	// SYN to the direct server is handled by the userspace stack, which
+	// answers with a SYN-ACK once the bypass connection is established.
+	dst := netip.MustParseAddrPort(ln.Addr().String())
+	h.fromOS(tcpSyn(client, dst))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	synack := h.expectToOS(3 * time.Second)
+	var sinfo packetInfo
+	parsePacket(synack, &sinfo)
+	if sinfo.proto != protoTCP || sinfo.tcpFlags&(tcpFlagSYN|tcpFlagACK) != tcpFlagSYN|tcpFlagACK || sinfo.src != dst.Addr() || sinfo.srcPort != dst.Port() {
+		t.Fatalf("expected SYN-ACK from %v, got %+v", dst, sinfo)
+	}
+}
+
+func TestRouterDirectUDP(t *testing.T) {
+	pc, err := net.ListenPacket("udp4", "127.0.0.1:0") // UDP relay does not involve gVisor
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer pc.Close()
+	go func() {
+		buf := make([]byte, 1500)
+		for {
+			n, addr, err := pc.ReadFrom(buf)
+			if err != nil {
+				return
+			}
+			pc.WriteTo(append([]byte("echo:"), buf[:n]...), addr)
+		}
+	}()
+	h := newHarness(t, baseConfig())
+	dst := netip.MustParseAddrPort(pc.LocalAddr().String())
+	h.fromOS(buildUDPPacket(0, client, dst, []byte("ping")))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	back := h.expectToOS(2 * time.Second)
+	info, payload := udpPayload(t, back)
+	if info.src != dst.Addr() || info.srcPort != dst.Port() || string(payload) != "echo:ping" {
+		t.Fatalf("unexpected UDP reply %+v %q", info, payload)
+	}
+	verifyChecksums(t, back)
+}
+
+func TestRouterTCPDNS(t *testing.T) {
+	h := newHarness(t, baseConfig())
+	// A SYN to the router's DNS address must be answered locally.
+	h.fromOS(tcpSyn(client, vip))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	synack := h.expectToOS(time.Second)
+	var info packetInfo
+	parsePacket(synack, &info)
+	if info.tcpFlags&(tcpFlagSYN|tcpFlagACK) != tcpFlagSYN|tcpFlagACK {
+		t.Fatalf("expected SYN-ACK, got %+v", info)
