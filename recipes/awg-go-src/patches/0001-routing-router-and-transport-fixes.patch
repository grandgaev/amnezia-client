+
+package router
+
+import (
+	"net"
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	udpIdleTimeout    = 2 * time.Minute
+	udpDNSIdleTimeout = 20 * time.Second
+	udpReadBufferSize = 64 * 1024
+)
+
+type udpFlow struct {
+	conn       *net.UDPConn
+	client     netip.AddrPort
+	remote     netip.AddrPort
+	lastActive atomic.Int64
+	closed     atomic.Bool
+}
+
+// udpForwarder relays datagrams of direct flows through sockets that bypass
+// the tunnel. It works at the packet level: no userspace stack is involved.
+type udpForwarder struct {
+	st    *state
+	mu    sync.Mutex
+	flows map[flowKey]*udpFlow
+	wg    sync.WaitGroup
+}
+
+func newUDPForwarder(st *state) *udpForwarder {
+	return &udpForwarder{st: st, flows: make(map[flowKey]*udpFlow)}
+}
+
+func (u *udpForwarder) handle(pkt []byte, info *packetInfo) {
+	if info.fragment {
+		// Reassembly is not supported for direct UDP; drop.
+		return
+	}
+	key := flowKey{proto: protoUDP, src: netip.AddrPortFrom(info.src, info.srcPort), dst: netip.AddrPortFrom(info.dst, info.dstPort)}
+	payload := pkt[info.ipHdrLen+udpHeaderLen : info.totalLen]
+
+	u.mu.Lock()
+	f := u.flows[key]
+	if f == nil || f.closed.Load() {
+		if len(u.flows) >= maxUDPFlows {
+			u.evictLocked()
+		}
+		conn, err := u.st.r.bypass.dialUDP(key.dst)
+		if err != nil {
+			u.mu.Unlock()
+			u.st.r.log.Verbosef("router: direct UDP to %v failed: %v", key.dst, err)
+			return
+		}
+		f = &udpFlow{conn: conn, client: key.src, remote: key.dst}
+		f.lastActive.Store(time.Now().UnixNano())
+		u.flows[key] = f
+		u.wg.Add(1)
+		go u.readLoop(key, f)
+	}
+	u.mu.Unlock()
+	f.lastActive.Store(time.Now().UnixNano())
+	f.conn.Write(payload)
+}
+
+func (u *udpForwarder) evictLocked() {
+	var oldestKey flowKey
+	var oldest int64 = 1<<63 - 1
+	for k, f := range u.flows {
+		if t := f.lastActive.Load(); t < oldest {
+			oldest = t
+			oldestKey = k
+		}
+	}
+	if f := u.flows[oldestKey]; f != nil {
+		f.closed.Store(true)
+		f.conn.Close()
+		delete(u.flows, oldestKey)
+	}
+}
+
+func (u *udpForwarder) readLoop(key flowKey, f *udpFlow) {
+	defer u.wg.Done()
+	defer func() {
+		f.closed.Store(true)
+		f.conn.Close()
+		u.mu.Lock()
+		if u.flows[key] == f {
+			delete(u.flows, key)
+		}
+		u.mu.Unlock()
+		u.st.flows.remove(key)
+	}()
+	idle := udpIdleTimeout
+	if key.dst.Port() == 53 {
+		idle = udpDNSIdleTimeout
+	}
+	buf := make([]byte, udpReadBufferSize)
+	for {
+		f.conn.SetReadDeadline(time.Now().Add(idle))
+		n, err := f.conn.Read(buf)
+		if err != nil {
+			if ne, ok := err.(net.Error); ok && ne.Timeout() && !f.closed.Load() {
+				if time.Since(time.Unix(0, f.lastActive.Load())) < idle {
+					continue
+				}
+			}
+			return
+		}
+		f.lastActive.Store(time.Now().UnixNano())
+		u.st.r.writeInjected(buildUDPPacket(injectHeadroom, f.remote, f.client, buf[:n]))
+	}
+}
+
+func (u *udpForwarder) close() {
+	u.mu.Lock()
+	for k, f := range u.flows {
+		f.closed.Store(true)
+		f.conn.Close()
+		delete(u.flows, k)
+	}
+	u.mu.Unlock()
+	u.wg.Wait()
+}
