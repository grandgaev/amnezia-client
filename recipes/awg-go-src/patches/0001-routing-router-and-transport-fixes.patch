diff --git a/router/bypass.go b/router/bypass.go
new file mode 100644
index 0000000..c33b221
--- /dev/null
+++ b/router/bypass.go
@@ -0,0 +1,107 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"context"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"syscall"
+	"time"
+)
+
+var socketProtector atomic.Pointer[func(fd int) bool]
+
+// SetSocketProtector installs a callback used to exclude sockets opened by
+// the router from the tunnel (e.g. VpnService.protect on Android). Passing
+// nil removes it.
+func SetSocketProtector(protect func(fd int) bool) {
+	if protect == nil {
+		socketProtector.Store(nil)
+		return
+	}
+	socketProtector.Store(&protect)
+}
+
+// bypass creates sockets that leave the host outside of the tunnel.
+type bypass struct {
+	ifIndex4 atomic.Uint32
+	ifIndex6 atomic.Uint32
+	ifName   atomic.Pointer[string]
+	fwmark   atomic.Uint32
+}
+
+func (b *bypass) setInterfaceName(name string) {
+	b.ifName.Store(&name)
+}
+
+func (b *bypass) interfaceName() string {
+	if p := b.ifName.Load(); p != nil {
+		return *p
+	}
+	return ""
+}
+
+// available reports whether direct sockets can be created without looping
+// back into the tunnel.
+func (b *bypass) available(osGuarantee bool) bool {
+	if osGuarantee || socketProtector.Load() != nil {
+		return true
+	}
+	return b.ifIndex4.Load() != 0 || b.ifIndex6.Load() != 0 || b.interfaceName() != "" || b.fwmark.Load() != 0
+}
+
+func (b *bypass) control(network, address string, c syscall.RawConn) error {
+	var ctrlErr error
+	err := c.Control(func(fd uintptr) {
+		if p := socketProtector.Load(); p != nil {
+			if !(*p)(int(fd)) {
+				ctrlErr = errProtectFailed
+			}
+			return
+		}
+		ctrlErr = b.bindSocket(network, fd)
+	})
+	if err != nil {
+		return err
+	}
+	return ctrlErr
+}
+
+func familyNetwork(proto string, addr netip.Addr) string {
+	if addr.Unmap().Is4() {
+		return proto + "4"
+	}
+	return proto + "6"
+}
+
+func (b *bypass) dialer(timeout time.Duration) *net.Dialer {
+	return &net.Dialer{
+		Timeout:   timeout,
+		KeepAlive: 30 * time.Second,
+		Control:   b.control,
+	}
+}
+
+func (b *bypass) dialTCP(ctx context.Context, dst netip.AddrPort) (net.Conn, error) {
+	dst = netip.AddrPortFrom(dst.Addr().Unmap(), dst.Port())
+	return b.dialer(10*time.Second).DialContext(ctx, familyNetwork("tcp", dst.Addr()), dst.String())
+}
+
+func (b *bypass) dialUDP(dst netip.AddrPort) (*net.UDPConn, error) {
+	dst = netip.AddrPortFrom(dst.Addr().Unmap(), dst.Port())
+	c, err := b.dialer(5*time.Second).Dial(familyNetwork("udp", dst.Addr()), dst.String())
+	if err != nil {
+		return nil, err
+	}
+	return c.(*net.UDPConn), nil
+}
+
+func (b *bypass) listenPacket(network string) (net.PacketConn, error) {
+	lc := net.ListenConfig{Control: b.control}
+	return lc.ListenPacket(context.Background(), network, "")
+}
