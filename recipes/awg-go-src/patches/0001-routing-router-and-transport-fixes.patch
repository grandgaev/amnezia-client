+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"context"
+	"encoding/binary"
+	"errors"
+	"math/rand/v2"
+	"net/netip"
+	"sync"
+	"time"
+
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+const (
+	dnsPendingTimeout = 15 * time.Second
+	dnsLearnGrace     = 10 * time.Minute
+	dnsMaxLearned     = 250000
+	dnsDirectTimeout  = 2500 * time.Millisecond
+	dnsInternalWait   = 4 * time.Second
+	dnsRetryWindow    = 4 * time.Second
+)
+
+var dnsBufPool = sync.Pool{New: func() any {
+	b := make([]byte, 65535)
+	return &b
+}}
+
+type pendingKey struct {
+	local    netip.AddrPort // the querying socket inside the tunnel
+	upstream netip.AddrPort
+	id       uint16
+}
+
+type pendingQuery struct {
+	origDst netip.AddrPort // address the client originally queried
+	rule    int
+	expires int64
+	done    chan []byte // non-nil for queries issued by the router itself
+}
+
+type learnedEntry struct {
+	rule    int32
+	expires int64
+}
+
+type retryKey struct {
+	client netip.AddrPort
+	name   string
+	qtype  dnsmessage.Type
+}
+
+type retryEntry struct {
+	count int
+	last  int64
+}
+
+type dnsEngine struct {
+	st *state
+
+	mu      sync.Mutex
+	pending map[pendingKey]*pendingQuery
+	retries map[retryKey]*retryEntry
+
+	learnedMu sync.RWMutex
+	learned   map[netip.Addr]learnedEntry
+}
+
+func newDNSEngine(st *state) *dnsEngine {
+	return &dnsEngine{
+		st:      st,
+		pending: make(map[pendingKey]*pendingQuery),
+		retries: make(map[retryKey]*retryEntry),
+		learned: make(map[netip.Addr]learnedEntry),
+	}
+}
+
+func (e *dnsEngine) actionOfRule(rule int) Action {
+	if rule < 0 || rule >= len(e.st.cfg.rules) {
+		return e.st.cfg.defaultAction
+	}
+	return e.st.cfg.rules[rule].action
+}
+
+// lookupLearned returns the index of the rule matched by the name the
+// address was most recently resolved from, or -1.
+func (e *dnsEngine) lookupLearned(addr netip.Addr, now int64) int {
+	e.learnedMu.RLock()
+	le, ok := e.learned[addr.Unmap()]
+	e.learnedMu.RUnlock()
+	if !ok || le.expires < now {
+		return -1
+	}
+	return int(le.rule)
+}
+
+func (e *dnsEngine) setLearned(addr netip.Addr, rule int, expires int64, now int64) {
+	addr = addr.Unmap()
+	e.learnedMu.Lock()
+	defer e.learnedMu.Unlock()
+	existing, ok := e.learned[addr]
+	if rule < 0 && !ok {
+		return
+	}
+	if ok && existing.expires > now && int(existing.rule) != rule {
+		// Several names can share an address (CDNs). Prefer sending such
+		// addresses through the tunnel: that keeps working for every name,
+		// while a direct path may be blocked for some of them.
+		if e.actionOfRule(int(existing.rule)) == ActionProxy && e.actionOfRule(rule) != ActionProxy {
+			if expires > existing.expires {
+				existing.expires = expires
+				e.learned[addr] = existing
+			}
+			return
+		}
+	}
+	if len(e.learned) >= dnsMaxLearned && !ok {
+		for k, v := range e.learned {
+			if v.expires < now {
+				delete(e.learned, k)
+			}
+		}
+		if len(e.learned) >= dnsMaxLearned {
+			n := 0
+			for k := range e.learned {
+				delete(e.learned, k)
+				n++
+				if n > dnsMaxLearned/10 {
+					break
+				}
+			}
+		}
+	}
+	e.learned[addr] = learnedEntry{rule: int32(rule), expires: expires}
+}
+
+// learn records the addresses found in a DNS response.
+func (e *dnsEngine) learn(msg []byte, rule int) {
+	var p dnsmessage.Parser
+	if _, err := p.Start(msg); err != nil {
+		return
+	}
+	if err := p.SkipAllQuestions(); err != nil {
+		return
+	}
+	now := time.Now().UnixNano()
+	minTTL := e.st.cfg.minTTL
+	for {
+		h, err := p.AnswerHeader()
+		if err != nil {
+			return
+		}
+		ttl := h.TTL
+		if ttl < minTTL {
+			ttl = minTTL
+		}
+		expires := now + int64(time.Duration(ttl)*time.Second) + int64(dnsLearnGrace)
+		switch h.Type {
+		case dnsmessage.TypeA:
+			r, err := p.AResource()
+			if err != nil {
+				return
+			}
+			e.setLearned(netip.AddrFrom4(r.A), rule, expires, now)
+		case dnsmessage.TypeAAAA:
+			r, err := p.AAAAResource()
+			if err != nil {
+				return
+			}
+			e.setLearned(netip.AddrFrom16(r.AAAA), rule, expires, now)
+		default:
+			if err := p.SkipAnswer(); err != nil {
+				return
+			}
+		}
+	}
+}
+
+type dnsQuestion struct {
+	header dnsmessage.Header
+	q      dnsmessage.Question
+	name   string
+}
+
+func parseQuestion(msg []byte) (*dnsQuestion, error) {
+	var p dnsmessage.Parser
+	h, err := p.Start(msg)
+	if err != nil {
+		return nil, err
+	}
+	if h.Response {
+		return nil, errors.New("not a query")
+	}
+	q, err := p.Question()
+	if err != nil {
+		return nil, err
+	}
+	return &dnsQuestion{header: h, q: q, name: NormalizeDomain(q.Name.String())}, nil
+}
+
+// synthesize builds a local answer: addrs (may be empty) or NXDOMAIN.
+func synthesize(dq *dnsQuestion, addrs []netip.Addr, nxdomain bool, ttl uint32) []byte {
+	h := dnsmessage.Header{
+		ID:                 dq.header.ID,
+		Response:           true,
+		OpCode:             dq.header.OpCode,
+		RecursionDesired:   dq.header.RecursionDesired,
+		RecursionAvailable: true,
+		RCode:              dnsmessage.RCodeSuccess,
+	}
+	if nxdomain {
+		h.RCode = dnsmessage.RCodeNameError
+	}
+	b := dnsmessage.NewBuilder(make([]byte, 0, 512), h)
+	b.EnableCompression()
+	if err := b.StartQuestions(); err != nil {
+		return nil
+	}
+	if err := b.Question(dq.q); err != nil {
+		return nil
+	}
+	if err := b.StartAnswers(); err != nil {
+		return nil
+	}
+	if !nxdomain {
+		for _, a := range addrs {
+			rh := dnsmessage.ResourceHeader{Name: dq.q.Name, Class: dnsmessage.ClassINET, TTL: ttl}
+			if a.Is4() && dq.q.Type == dnsmessage.TypeA {
+				if err := b.AResource(rh, dnsmessage.AResource{A: a.As4()}); err != nil {
+					return nil
+				}
+			} else if a.Is6() && !a.Is4In6() && dq.q.Type == dnsmessage.TypeAAAA {
+				if err := b.AAAAResource(rh, dnsmessage.AAAAResource{AAAA: a.As16()}); err != nil {
+					return nil
+				}
+			}
+		}
+	}
+	out, err := b.Finish()
+	if err != nil {
+		return nil
+	}
+	return out
+}
+
+func servfail(msg []byte) []byte {
+	if len(msg) < 12 {
+		return nil
+	}
+	out := make([]byte, len(msg))
+	copy(out, msg)
+	// QR=1, keep opcode and RD, RA=1, RCODE=SERVFAIL
+	out[2] = 0x80 | (msg[2] & 0x79)
+	out[3] = 0x80 | 2
+	return out
+}
+
+// localAnswer returns an answer the router can give without contacting
+// any upstream (static hosts, blocked names), or nil.
+func (e *dnsEngine) localAnswer(dq *dnsQuestion) (answer []byte, rule int, handled bool) {
+	cfg := e.st.cfg
+	if addrs, ok := cfg.hosts[dq.name]; ok && (dq.q.Type == dnsmessage.TypeA || dq.q.Type == dnsmessage.TypeAAAA) {
+		_, rule := cfg.domainAction(dq.name)
+		return synthesize(dq, addrs, false, 60), rule, true
+	}
+	action, rule := cfg.domainAction(dq.name)
+	if action == ActionBlock {
+		if cfg.blockZero && (dq.q.Type == dnsmessage.TypeA || dq.q.Type == dnsmessage.TypeAAAA) {
+			return synthesize(dq, []netip.Addr{netip.IPv4Unspecified(), netip.IPv6Unspecified()}, false, 60), -1, true
+		}
+		return synthesize(dq, nil, true, 60), -1, true
+	}
+	if cfg.rejectV6Proxy && dq.q.Type == dnsmessage.TypeAAAA && action == ActionProxy {
+		// No IPv6 through the tunnel: answer "no AAAA records" so that the
+		// application connects over IPv4 right away.
+		return synthesize(dq, nil, false, 60), rule, true
+	}
+	return nil, rule, false
+}
+
+// handleQuery processes a UDP DNS query read from the OS. It returns true
+// when the (possibly rewritten) packet must be sent through the tunnel.
+func (e *dnsEngine) handleQuery(pkt []byte, info *packetInfo) bool {
+	payload := pkt[info.ipHdrLen+udpHeaderLen : info.totalLen]
+	client := netip.AddrPortFrom(info.src, info.srcPort)
+	orig := netip.AddrPortFrom(info.dst, info.dstPort)
+	dq, err := parseQuestion(payload)
+	if err != nil {
+		return e.forwardRemote(pkt, info, nil, -1)
+	}
+	if answer, rule, ok := e.localAnswer(dq); ok {
+		if answer != nil {
+			if rule >= 0 {
+				e.learn(answer, rule)
+			}
+			e.st.r.writeInjected(buildUDPPacket(injectHeadroom, orig, client, answer))
+		}
+		return false
+	}
+	action, rule := e.st.cfg.domainAction(dq.name)
+	if action == ActionDirect && (len(e.st.cfg.direct) > 0 || e.st.cfg.directDoH != nil) && e.st.bypassAvailable() {
+		query := append([]byte(nil), payload...)
+		go e.resolveDirectForClient(query, client, orig, rule)
+		return false
+	}
+	return e.forwardRemote(pkt, info, dq, rule)
+}
+
+// pickRemote selects a remote upstream of the requested family. Repeated
+// queries (client retries) rotate through the configured servers.
+func (e *dnsEngine) pickRemote(v4 bool, dq *dnsQuestion, client netip.AddrPort) (netip.AddrPort, bool) {
+	var candidates []netip.AddrPort
+	for _, s := range e.st.cfg.remote {
+		if s.Addr().Unmap().Is4() == v4 {
+			candidates = append(candidates, s)
+		}
+	}
+	if len(candidates) == 0 {
+		return netip.AddrPort{}, false
+	}
+	idx := 0
+	if dq != nil && len(candidates) > 1 {
+		now := time.Now().UnixNano()
+		key := retryKey{client: client, name: dq.name, qtype: dq.q.Type}
+		e.mu.Lock()
+		re := e.retries[key]
+		if re != nil && now-re.last < int64(dnsRetryWindow) {
+			re.count++
+		} else {
+			re = &retryEntry{}
+			e.retries[key] = re
+		}
+		re.last = now
+		idx = re.count % len(candidates)
+		e.mu.Unlock()
+	}
+	s := candidates[idx]
+	return netip.AddrPortFrom(s.Addr().Unmap(), s.Port()), true
+}
+
+func (e *dnsEngine) forwardRemote(pkt []byte, info *packetInfo, dq *dnsQuestion, rule int) bool {
+	payload := pkt[info.ipHdrLen+udpHeaderLen : info.totalLen]
+	if len(payload) < 12 {
+		return false
+	}
+	client := netip.AddrPortFrom(info.src, info.srcPort)
+	orig := netip.AddrPortFrom(info.dst, info.dstPort)
+	up, ok := e.pickRemote(info.version == 4, dq, client)
+	if !ok {
+		if e.st.cfg.isListenAddr(info.dst) {
+			if sf := servfail(payload); sf != nil {
+				e.st.r.writeInjected(buildUDPPacket(injectHeadroom, orig, client, sf))
+			}
+			return false
+		}
+		// No upstream of this family: let the query go to its original
+		// destination through the tunnel.
+		return true
+	}
+	if up != orig {
+		setAddr(pkt, info, false, up.Addr())
+		if up.Port() != info.dstPort {
+			binary.BigEndian.PutUint16(pkt[info.ipHdrLen+2:info.ipHdrLen+4], up.Port())
+			info.dstPort = up.Port()
+		}
+		fixChecksums(pkt, info)
+	}
+	id := binary.BigEndian.Uint16(payload[0:2])
+	e.mu.Lock()
+	e.pending[pendingKey{local: client, upstream: up, id: id}] = &pendingQuery{
+		origDst: orig,
+		rule:    rule,
+		expires: time.Now().Add(dnsPendingTimeout).UnixNano(),
+	}
+	e.mu.Unlock()
+	return true
+}
+
+// handleResponse inspects a UDP packet coming from the tunnel. It returns
+// false when the packet was consumed by the router.
+func (e *dnsEngine) handleResponse(pkt []byte, info *packetInfo) bool {
+	payload := pkt[info.ipHdrLen+udpHeaderLen : info.totalLen]
+	if len(payload) < 12 {
+		return true
+	}
+	key := pendingKey{
+		local:    netip.AddrPortFrom(info.dst, info.dstPort),
+		upstream: netip.AddrPortFrom(info.src, info.srcPort),
+		id:       binary.BigEndian.Uint16(payload[0:2]),
+	}
+	e.mu.Lock()
+	pq := e.pending[key]
+	if pq != nil {
+		delete(e.pending, key)
+	}
+	e.mu.Unlock()
+	if pq == nil {
+		return true
+	}
+	if pq.done == nil {
+		e.learn(payload, pq.rule)
+	} else {
+		select {
+		case pq.done <- append([]byte(nil), payload...):
+		default:
+		}
+		return false
+	}
+	if pq.origDst != key.upstream {
+		setAddr(pkt, info, true, pq.origDst.Addr())
+		if pq.origDst.Port() != info.srcPort {
+			binary.BigEndian.PutUint16(pkt[info.ipHdrLen:info.ipHdrLen+2], pq.origDst.Port())
+			info.srcPort = pq.origDst.Port()
+		}
+		fixChecksums(pkt, info)
+	}
+	return true
+}
+
+// exchangeDirect queries the direct upstreams from outside the tunnel.
+func (e *dnsEngine) exchangeDirect(query []byte) ([]byte, error) {
+	var lastErr error = errNoBypass
+	if doh := e.st.cfg.directDoH; doh != nil && doh.client != nil {
+		ctx, cancel := context.WithTimeout(e.st.ctx, dohTimeout)
+		resp, err := doh.exchange(ctx, query)
+		cancel()
+		if err == nil {
+			return resp, nil
+		}
+		e.st.r.log.Verbosef("router: DNS-over-HTTPS failed (%v), trying plain DNS", err)
+		lastErr = err
+	}
+	id := binary.BigEndian.Uint16(query[0:2])
+	bufp := dnsBufPool.Get().(*[]byte)
+	defer dnsBufPool.Put(bufp)
+	buf := *bufp
+	for _, up := range e.st.cfg.direct {
+		conn, err := e.st.r.bypass.dialUDP(up)
+		if err != nil {
+			lastErr = err
+			continue
+		}
+		conn.SetDeadline(time.Now().Add(dnsDirectTimeout))
+		if _, err := conn.Write(query); err != nil {
+			conn.Close()
+			lastErr = err
+			continue
+		}
+		for {
+			n, err := conn.Read(buf)
+			if err != nil {
+				lastErr = err
+				break
+			}
+			if n >= 12 && binary.BigEndian.Uint16(buf[0:2]) == id {
+				conn.Close()
+				return append([]byte(nil), buf[:n]...), nil
+			}
+		}
+		conn.Close()
+	}
+	return nil, lastErr
+}
+
+func (e *dnsEngine) resolveDirectForClient(query []byte, client, orig netip.AddrPort, rule int) {
+	resp, err := e.exchangeDirect(query)
+	if err == nil {
+		e.learn(resp, rule)
+		e.st.r.writeInjected(buildUDPPacket(injectHeadroom, orig, client, resp))
+		return
+	}
+	e.st.r.log.Verbosef("router: direct DNS failed (%v), using the tunnel", err)
+	// Fall back to the remote resolver through the tunnel, pretending the
+	// client sent the query there.
+	up, ok := e.pickRemote(client.Addr().Is4(), nil, client)
+	if !ok || e.st.r.injectOutbound == nil {
+		if sf := servfail(query); sf != nil {
+			e.st.r.writeInjected(buildUDPPacket(injectHeadroom, orig, client, sf))
+		}
+		return
+	}
+	id := binary.BigEndian.Uint16(query[0:2])
+	e.mu.Lock()
+	e.pending[pendingKey{local: client, upstream: up, id: id}] = &pendingQuery{
+		origDst: orig,
+		rule:    rule,
+		expires: time.Now().Add(dnsPendingTimeout).UnixNano(),
+	}
+	e.mu.Unlock()
+	e.st.r.injectOutbound(buildUDPPacket(0, client, up, query))
+}
+
+// exchangeRemote sends a query generated by the router through the tunnel
+// using local (an address of this host inside the tunnel) as the source.
+func (e *dnsEngine) exchangeRemote(query []byte, local netip.Addr) ([]byte, error) {
+	if e.st.r.injectOutbound == nil {
+		return nil, errors.New("tunnel injection unavailable")
+	}
+	up, ok := e.pickRemote(local.Is4(), nil, netip.AddrPort{})
+	if !ok {
+		return nil, errors.New("no remote DNS server for this address family")
+	}
+	src := netip.AddrPortFrom(local, uint16(20000+rand.IntN(40000)))
+	id := binary.BigEndian.Uint16(query[0:2])
+	done := make(chan []byte, 1)
+	key := pendingKey{local: src, upstream: up, id: id}
+	e.mu.Lock()
+	e.pending[key] = &pendingQuery{
+		origDst: up,
+		rule:    -2,
+		expires: time.Now().Add(dnsPendingTimeout).UnixNano(),
+		done:    done,
+	}
+	e.mu.Unlock()
+	e.st.r.injectOutbound(buildUDPPacket(0, src, up, query))
+	select {
+	case resp := <-done:
+		return resp, nil
+	case <-time.After(dnsInternalWait):
+		e.mu.Lock()
+		delete(e.pending, key)
+		e.mu.Unlock()
+		return nil, errors.New("remote DNS timeout")
+	case <-e.st.ctx.Done():
+		return nil, e.st.ctx.Err()
+	}
+}
+
+// resolve answers a query for the router's own DNS server (DNS over TCP).
+func (e *dnsEngine) resolve(query []byte, local netip.Addr) []byte {
+	dq, err := parseQuestion(query)
+	if err != nil {
+		return servfail(query)
+	}
+	if answer, rule, ok := e.localAnswer(dq); ok {
+		if answer != nil && rule >= 0 {
+			e.learn(answer, rule)
+		}
+		return answer
+	}
+	action, rule := e.st.cfg.domainAction(dq.name)
+	if action == ActionDirect && (len(e.st.cfg.direct) > 0 || e.st.cfg.directDoH != nil) && e.st.bypassAvailable() {
+		if resp, err := e.exchangeDirect(query); err == nil {
+			e.learn(resp, rule)
+			return resp
+		}
+	}
+	resp, err := e.exchangeRemote(query, local)
+	if err != nil {
+		return servfail(query)
+	}
+	e.learn(resp, rule)
+	return resp
+}
+
+func (e *dnsEngine) sweep(now int64) {
+	e.mu.Lock()
+	for k, v := range e.pending {
+		if v.expires < now {
+			delete(e.pending, k)
+		}
+	}
+	for k, v := range e.retries {
+		if now-v.last > int64(dnsRetryWindow) {
+			delete(e.retries, k)
+		}
+	}
+	e.mu.Unlock()
+	e.learnedMu.Lock()
+	for k, v := range e.learned {
+		if v.expires < now {
+			delete(e.learned, k)
+		}
+	}
+	e.learnedMu.Unlock()
+}
diff --git a/router/doh.go b/router/doh.go
new file mode 100644
index 0000000..f5dd3ad
--- /dev/null
+++ b/router/doh.go
@@ -0,0 +1,162 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"bytes"
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/netip"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync/atomic"
+	"time"
+)
+
+const (
+	dohTimeout       = 5 * time.Second
+	dohMaxResponse   = 64 * 1024
+	dohIdleTimeout   = 90 * time.Second
+	dohContentType   = "application/dns-message"
+	dohDefaultPort   = 443
+	dohMaxIdleConns  = 2
+	dohHandshakeWait = 5 * time.Second
+)
+
+// DoHConfig describes a DNS-over-HTTPS resolver for direct names. The
+// resolver is reached outside the tunnel at the given addresses, so the host
+// of URL never has to be resolved.
+type DoHConfig struct {
+	URL   string   `json:"url"`
+	Addrs []string `json:"addrs,omitempty"`
+}
+
+type dohUpstream struct {
+	url    string
+	host   string
+	addrs  []netip.AddrPort
+	client *http.Client
+	next   atomic.Uint32
+}
+
+func compileDoH(cfg *DoHConfig) (*dohUpstream, error) {
+	if cfg == nil || strings.TrimSpace(cfg.URL) == "" {
+		return nil, nil
+	}
+	u, err := url.Parse(strings.TrimSpace(cfg.URL))
+	if err != nil {
+		return nil, err
+	}
+	if u.Scheme != "https" || u.Hostname() == "" {
+		return nil, fmt.Errorf("not an https URL")
+	}
+	port := dohDefaultPort
+	if p := u.Port(); p != "" {
+		port, err = strconv.Atoi(p)
+		if err != nil || port <= 0 || port > 65535 {
+			return nil, fmt.Errorf("invalid port %q", p)
+		}
+	}
+	d := &dohUpstream{url: u.String(), host: u.Hostname()}
+	for _, s := range cfg.Addrs {
+		a, err := netip.ParseAddr(strings.TrimSpace(s))
+		if err != nil {
+			return nil, fmt.Errorf("address %q: %w", s, err)
+		}
+		d.addrs = append(d.addrs, netip.AddrPortFrom(a.Unmap(), uint16(port)))
+	}
+	if len(d.addrs) == 0 {
+		// The host itself may be an address literal.
+		if a, err := netip.ParseAddr(d.host); err == nil {
+			d.addrs = append(d.addrs, netip.AddrPortFrom(a.Unmap(), uint16(port)))
+		} else {
+			return nil, fmt.Errorf("no address for %s", d.host)
+		}
+	}
+	return d, nil
+}
+
+// start creates the HTTP client; connections are made through the bypass.
+func (d *dohUpstream) start(b *bypass) {
+	transport := &http.Transport{
+		DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			var lastErr error
+			first := int(d.next.Load())
+			for i := range d.addrs {
+				ap := d.addrs[(first+i)%len(d.addrs)]
+				conn, err := b.dialTCP(ctx, ap)
+				if err == nil {
+					return conn, nil
+				}
+				lastErr = err
+				// Prefer the next address for the following connections.
+				d.next.Store(uint32((first + i + 1) % len(d.addrs)))
+			}
+			return nil, lastErr
+		},
+		TLSClientConfig:     &tls.Config{ServerName: d.host, MinVersion: tls.VersionTLS12},
+		TLSHandshakeTimeout: dohHandshakeWait,
+		ForceAttemptHTTP2:   true,
+		MaxIdleConns:        dohMaxIdleConns,
+		MaxIdleConnsPerHost: dohMaxIdleConns,
+		IdleConnTimeout:     dohIdleTimeout,
+		// Never use a proxy from the environment: this must go out directly.
+		Proxy: nil,
+	}
+	d.client = &http.Client{Transport: transport, Timeout: dohTimeout}
+}
+
+func (d *dohUpstream) close() {
+	if d != nil && d.client != nil {
+		d.client.CloseIdleConnections()
+	}
+}
+
+var errDoHResponse = errors.New("invalid DNS-over-HTTPS response")
+
+// exchange sends a DNS query (RFC 8484 POST) and returns the response with
+// the ID of the original query.
+func (d *dohUpstream) exchange(ctx context.Context, query []byte) ([]byte, error) {
+	if len(query) < 12 {
+		return nil, errDoHResponse
+	}
+	id := binary.BigEndian.Uint16(query[0:2])
+	body := append([]byte(nil), query...)
+	// RFC 8484 4.1: the DNS ID should be 0 to maximise HTTP cache friendliness.
+	binary.BigEndian.PutUint16(body[0:2], 0)
+
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, d.url, bytes.NewReader(body))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Content-Type", dohContentType)
+	req.Header.Set("Accept", dohContentType)
+	resp, err := d.client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		io.Copy(io.Discard, io.LimitReader(resp.Body, dohMaxResponse))
+		return nil, fmt.Errorf("DNS-over-HTTPS status %d", resp.StatusCode)
+	}
+	msg, err := io.ReadAll(io.LimitReader(resp.Body, dohMaxResponse+1))
+	if err != nil {
+		return nil, err
+	}
+	if len(msg) < 12 || len(msg) > dohMaxResponse {
+		return nil, errDoHResponse
+	}
+	binary.BigEndian.PutUint16(msg[0:2], id)
+	return msg, nil
+}
diff --git a/router/doh_test.go b/router/doh_test.go
new file mode 100644
index 0000000..177612a
--- /dev/null
+++ b/router/doh_test.go
@@ -0,0 +1,77 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"context"
+	"encoding/binary"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"golang.org/x/net/dns/dnsmessage"
+)
+
+func TestDoHExchange(t *testing.T) {
+	var gotID uint16
+	server := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodPost || r.Header.Get("Content-Type") != dohContentType {
+			http.Error(w, "bad request", http.StatusBadRequest)
+			return
+		}
+		body, _ := io.ReadAll(r.Body)
+		gotID = binary.BigEndian.Uint16(body[0:2])
+		resp := append([]byte(nil), body...)
+		resp[2] |= 0x80 // QR
+		w.Header().Set("Content-Type", dohContentType)
+		w.Write(resp)
+	}))
+	defer server.Close()
+
+	doh, err := compileDoH(&DoHConfig{URL: server.URL + "/dns-query"})
+	if err != nil {
+		t.Fatal(err)
+	}
+	var b bypass
+	doh.start(&b)
+	doh.client.Transport.(*http.Transport).TLSClientConfig.RootCAs = server.Client().Transport.(*http.Transport).TLSClientConfig.RootCAs
+	defer doh.close()
+
+	query := dnsQuery(t, 0x1234, "example.com.", dnsmessage.TypeA)
+	resp, err := doh.exchange(context.Background(), query)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if gotID != 0 {
+		t.Fatalf("query ID sent over DoH = %#x, want 0", gotID)
+	}
+	if id := binary.BigEndian.Uint16(resp[0:2]); id != 0x1234 {
+		t.Fatalf("response ID = %#x, want 0x1234", id)
+	}
+	if resp[2]&0x80 == 0 {
+		t.Fatal("response flag not set")
+	}
+}
+
+func TestCompileDoH(t *testing.T) {
+	if d, err := compileDoH(nil); d != nil || err != nil {
+		t.Fatal("nil config must be accepted")
+	}
+	if _, err := compileDoH(&DoHConfig{URL: "https://dns.google/dns-query"}); err == nil {
+		t.Fatal("a host name without addresses must be rejected")
+	}
+	d, err := compileDoH(&DoHConfig{URL: "https://dns.google/dns-query", Addrs: []string{"8.8.8.8", "2001:4860:4860::8888"}})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(d.addrs) != 2 || d.addrs[0].Port() != 443 || d.host != "dns.google" {
+		t.Fatalf("unexpected upstream %+v", d)
+	}
+	if _, err := compileDoH(&DoHConfig{URL: "http://8.8.8.8/dns-query"}); err == nil {
+		t.Fatal("plain http must be rejected")
+	}
+}
diff --git a/router/flows.go b/router/flows.go
new file mode 100644
index 0000000..5851e10
--- /dev/null
+++ b/router/flows.go
@@ -0,0 +1,97 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"net/netip"
+	"sync"
+	"sync/atomic"
+	"time"
+)
+
+type flowKey struct {
+	proto uint8
+	src   netip.AddrPort
+	dst   netip.AddrPort
+}
+
+type flowEntry struct {
+	action  Action
+	expires atomic.Int64
+	ttl     int64
+}
+
+// flowTable pins routing decisions to connections so that a flow keeps its
+// path even if the learned DNS information changes while it is active.
+type flowTable struct {
+	mu        sync.RWMutex
+	m         map[flowKey]*flowEntry
+	directTCP atomic.Int32
+}
+
+func newFlowTable() *flowTable {
+	return &flowTable{m: make(map[flowKey]*flowEntry)}
+}
+
+func (t *flowTable) get(key flowKey, now int64) (Action, bool) {
+	t.mu.RLock()
+	e := t.m[key]
+	t.mu.RUnlock()
+	if e == nil {
+		return 0, false
+	}
+	if e.expires.Load() < now {
+		return 0, false
+	}
+	e.expires.Store(now + e.ttl)
+	return e.action, true
+}
+
+func (t *flowTable) put(key flowKey, action Action, ttl time.Duration, now int64) {
+	e := &flowEntry{action: action, ttl: int64(ttl)}
+	e.expires.Store(now + int64(ttl))
+	t.mu.Lock()
+	old := t.m[key]
+	t.m[key] = e
+	t.mu.Unlock()
+	if key.proto == protoTCP {
+		if old != nil && old.action == ActionDirect {
+			t.directTCP.Add(-1)
+		}
+		if action == ActionDirect {
+			t.directTCP.Add(1)
+		}
+	}
+}
+
+func (t *flowTable) remove(key flowKey) {
+	t.mu.Lock()
+	old := t.m[key]
+	delete(t.m, key)
+	t.mu.Unlock()
+	if old != nil && key.proto == protoTCP && old.action == ActionDirect {
+		t.directTCP.Add(-1)
+	}
+}
+
+func (t *flowTable) sweep(now int64) {
+	t.mu.Lock()
+	for k, e := range t.m {
+		if e.expires.Load() < now {
+			delete(t.m, k)
+			if k.proto == protoTCP && e.action == ActionDirect {
+				t.directTCP.Add(-1)
+			}
+		}
+	}
+	t.mu.Unlock()
+}
+
+func (t *flowTable) size() int {
+	t.mu.RLock()
+	defer t.mu.RUnlock()
+	return len(t.m)
+}
diff --git a/router/icmp.go b/router/icmp.go
new file mode 100644
index 0000000..a37fa7d
--- /dev/null
+++ b/router/icmp.go
@@ -0,0 +1,110 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"encoding/binary"
+	"net"
+	"net/netip"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/net/icmp"
+	"golang.org/x/net/ipv4"
+	"golang.org/x/net/ipv6"
+)
+
+const maxConcurrentPings = 32
+
+type icmpForwarder struct {
+	st       *state
+	inflight atomic.Int32
+}
+
+// handleEcho answers an ICMP echo request for a direct destination by
+// pinging it from outside the tunnel. Best effort: if unprivileged ICMP
+// sockets are unavailable the request is dropped.
+func (f *icmpForwarder) handleEcho(pkt []byte, info *packetInfo) {
+	if info.fragment {
+		return
+	}
+	l4 := pkt[info.ipHdrLen:info.totalLen]
+	if len(l4) < 8 {
+		return
+	}
+	if f.inflight.Add(1) > maxConcurrentPings {
+		f.inflight.Add(-1)
+		return
+	}
+	id := binary.BigEndian.Uint16(l4[4:6])
+	seq := binary.BigEndian.Uint16(l4[6:8])
+	data := append([]byte(nil), l4[8:]...)
+	src, dst := info.src, info.dst
+	go func() {
+		defer f.inflight.Add(-1)
+		reply, ok := f.ping(dst, seq, data)
+		if !ok {
+			return
+		}
+		f.st.r.writeInjected(buildICMPEchoReply(injectHeadroom, dst, src, id, seq, reply))
+	}()
+}
+
+func (f *icmpForwarder) ping(dst netip.Addr, seq uint16, data []byte) ([]byte, bool) {
+	dst = dst.Unmap()
+	var (
+		conn    net.PacketConn
+		err     error
+		msgType icmp.Type
+		proto   int
+		target  net.Addr
+	)
+	v6 := !dst.Is4()
+	if v6 {
+		msgType, proto = ipv6.ICMPTypeEchoRequest, 58
+	} else {
+		msgType, proto = ipv4.ICMPTypeEcho, 1
+	}
+	conn, err = f.st.r.bypass.openICMPSocket(v6)
+	if err == nil {
+		target = &net.UDPAddr{IP: dst.AsSlice()}
+	} else {
+		// Fall back to a raw socket (requires privileges).
+		network := "ip4:icmp"
+		if v6 {
+			network = "ip6:ipv6-icmp"
+		}
+		conn, err = f.st.r.bypass.listenPacket(network)
+		target = &net.IPAddr{IP: dst.AsSlice()}
+	}
+	if err != nil {
+		return nil, false
+	}
+	defer conn.Close()
+	msg := icmp.Message{Type: msgType, Body: &icmp.Echo{ID: int(seq), Seq: int(seq), Data: data}}
+	wb, err := msg.Marshal(nil)
+	if err != nil {
+		return nil, false
+	}
+	conn.SetDeadline(time.Now().Add(5 * time.Second))
+	if _, err := conn.WriteTo(wb, target); err != nil {
+		return nil, false
+	}
+	rb := make([]byte, 65535)
+	for {
+		n, _, err := conn.ReadFrom(rb)
+		if err != nil {
+			return nil, false
+		}
+		m, err := icmp.ParseMessage(proto, icmpReplyPayload(rb[:n], v6))
+		if err != nil {
+			continue
+		}
+		if echo, ok := m.Body.(*icmp.Echo); ok && (m.Type == ipv4.ICMPTypeEchoReply || m.Type == ipv6.ICMPTypeEchoReply) && echo.Seq == int(seq) {
+			return echo.Data, true
+		}
+	}
+}
