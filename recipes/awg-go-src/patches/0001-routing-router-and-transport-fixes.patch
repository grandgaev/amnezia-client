+func TestDomainSet(t *testing.T) {
+	s := &DomainSet{}
+	for _, e := range []string{"full:exact.com", "domain:example.org", "keyword:tube", "regexp:^api[0-9]+\\.svc\\.io$", "plain.net", "domain:.leading.dot"} {
+		if err := s.add(e); err != nil {
+			t.Fatal(err)
+		}
+	}
+	s.finalize()
+	cases := map[string]bool{
+		"exact.com":         true,
+		"www.exact.com":     false,
+		"example.org":       true,
+		"a.b.example.org":   true,
+		"notexample.org":    false,
+		"youtube.com":       true,
+		"api12.svc.io":      true,
+		"api.svc.io":        false,
+		"plain.net":         true,
+		"sub.plain.net":     true,
+		"x.leading.dot":     true,
+		"leading.dot":       true,
+		"unrelated.example": false,
+	}
+	for name, want := range cases {
+		if got := s.Match(name); got != want {
+			t.Errorf("Match(%q) = %v, want %v", name, got, want)
+		}
+	}
+	if err := (&DomainSet{}).add("regexp:(["); err == nil {
+		t.Error("invalid regexp accepted")
+	}
+}
