+}
+
+func TestRouterRejectProxyIPv6(t *testing.T) {
+	cfg := baseConfig()
+	cfg.RejectProxyIPv6 = true
+	h := newHarness(t, cfg)
+
+	client6 := netip.MustParseAddrPort("[fd58:baa6:dead::1]:40000")
+
+	// A proxied IPv6 connection is refused at once instead of being sent
+	// into a tunnel that carries no IPv6.
+	h.fromOS(tcpSyn(client6, netip.MustParseAddrPort("[2001:db8::1]:443")))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	rst := h.expectToOS(time.Second)
+	var rinfo packetInfo
+	if !parsePacket(rst, &rinfo) || rinfo.proto != protoTCP || rinfo.tcpFlags&tcpFlagRST == 0 {
+		t.Fatalf("expected an IPv6 RST, got %+v", rinfo)
+	}
+	verifyChecksums(t, rst)
+
+	// IPv4 keeps going through the tunnel.
+	syn := tcpSyn(client, netip.MustParseAddrPort("8.8.8.8:443"))
+	h.fromOS(syn)
+	if out := h.expectToTunnel(time.Second); string(out) != string(syn) {
+		t.Fatal("IPv4 proxy packet modified")
+	}
+
+	// Names going through the tunnel get no AAAA records.
+	q := dnsQuery(t, 0x4444, "www.blocked.example.", dnsmessage.TypeAAAA)
+	h.fromOS(buildUDPPacket(0, client, vip, q))
+	h.expectNothingToTunnel(100 * time.Millisecond)
+	back := h.expectToOS(time.Second)
+	_, payload := udpPayload(t, back)
+	var p dnsmessage.Parser
+	hdr, err := p.Start(payload)
+	if err != nil || hdr.RCode != dnsmessage.RCodeSuccess || hdr.ID != 0x4444 {
+		t.Fatalf("expected an empty NOERROR answer, got %+v %v", hdr, err)
+	}
+	p.SkipAllQuestions()
+	if _, err := p.AnswerHeader(); err != dnsmessage.ErrSectionDone {
+		t.Fatalf("expected no answers, got %v", err)
+	}
+
+	// A queries are still resolved through the tunnel.
+	q = dnsQuery(t, 0x5555, "www.blocked.example.", dnsmessage.TypeA)
+	h.fromOS(buildUDPPacket(0, client, vip, q))
+	out := h.expectToTunnel(time.Second)
+	if info, _ := udpPayload(t, out); info.dst != remote.Addr() {
+		t.Fatalf("A query not forwarded to the remote resolver: %+v", info)
+	}
+}
