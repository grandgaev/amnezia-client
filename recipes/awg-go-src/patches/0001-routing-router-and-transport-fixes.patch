+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"golang.org/x/sys/unix"
+)
+
+// On Linux (and Android) sockets are pinned with SO_BINDTODEVICE and/or the
+// firewall mark used by the daemon's policy routing.
+func (b *bypass) bindSocket(network string, fd uintptr) error {
+	if mark := b.fwmark.Load(); mark != 0 {
+		if err := unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_MARK, int(mark)); err != nil {
+			return err
+		}
+	}
+	if name := b.interfaceName(); name != "" {
+		return unix.BindToDevice(int(fd), name)
+	}
+	return nil
+}
