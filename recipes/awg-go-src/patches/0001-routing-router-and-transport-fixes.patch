+// --- router harness -------------------------------------------------------
+
+type harness struct {
+	t     *testing.T
+	ch    *tuntest.ChannelTUN
+	r     *Router
+	tunIn chan []byte // packets the router returned from Read (towards tunnel)
+	inj   chan []byte // packets injected into the tunnel by the router
+	toOS  chan []byte // packets written to the OS
+}
+
+func newHarness(t *testing.T, cfg Config) *harness {
+	t.Helper()
+	h := &harness{t: t, ch: tuntest.NewChannelTUN(), tunIn: make(chan []byte, 64), inj: make(chan []byte, 64), toOS: make(chan []byte, 64)}
+	go func() {
+		for p := range h.ch.Inbound {
+			h.toOS <- p
+		}
+	}()
+	h.r = New(h.ch.TUN(), Logger{Verbosef: t.Logf, Errorf: t.Logf}, func(pkt []byte) {
+		h.inj <- append([]byte(nil), pkt...)
+	})
+	data, _ := json.Marshal(cfg)
+	path := filepath.Join(t.TempDir(), "routing.json")
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if err := h.r.Configure(path); err != nil {
+		t.Fatal(err)
+	}
+	go func() {
+		bufs := [][]byte{make([]byte, 2048)}
+		sizes := []int{0}
+		for {
+			n, err := h.r.Read(bufs, sizes, 16)
+			if err != nil {
+				return
+			}
+			for i := 0; i < n; i++ {
+				if sizes[i] > 0 {
+					h.tunIn <- append([]byte(nil), bufs[i][16:16+sizes[i]]...)
+				}
+			}
+		}
+	}()
+	t.Cleanup(func() { h.r.Close() })
+	return h
+}
+
+// fromOS simulates the OS sending pkt into the TUN device.
+func (h *harness) fromOS(pkt []byte) { h.ch.Outbound <- pkt }
+
+// fromTunnel simulates the WireGuard device delivering pkt to the OS.
+func (h *harness) fromTunnel(pkt []byte) {
+	buf := make([]byte, 16+len(pkt))
+	copy(buf[16:], pkt)
+	if _, err := h.r.Write([][]byte{buf}, 16); err != nil {
+		h.t.Fatal(err)
+	}
+}
