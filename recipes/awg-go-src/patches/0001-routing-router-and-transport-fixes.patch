+++ b/router/bypass_darwin.go
@@ -0,0 +1,28 @@
+/* SPDX-License-Identifier: MIT
+ *
+ * Copyright (C) 2026 AmneziaVPN. All Rights Reserved.
+ */
+
+package router
+
+import (
+	"strings"
+
+	"golang.org/x/sys/unix"
+)
+
+func (b *bypass) bindSocket(network string, fd uintptr) error {
+	if strings.HasSuffix(network, "6") {
+		if idx := b.ifIndex6.Load(); idx != 0 {
+			return unix.SetsockoptInt(int(fd), unix.IPPROTO_IPV6, unix.IPV6_BOUND_IF, int(idx))
+		}
+		if idx := b.ifIndex4.Load(); idx != 0 {
+			return unix.SetsockoptInt(int(fd), unix.IPPROTO_IPV6, unix.IPV6_BOUND_IF, int(idx))
+		}
+		return nil
+	}
+	if idx := b.ifIndex4.Load(); idx != 0 {
+		return unix.SetsockoptInt(int(fd), unix.IPPROTO_IP, unix.IP_BOUND_IF, int(idx))
+	}
+	return nil
+}
